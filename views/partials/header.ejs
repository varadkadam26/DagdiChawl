<body>

  <!-- Studio Custom Interactive Follower Cursor -->
  <div class="custom-cursor-dot" id="customCursorDot"></div>
  <div class="custom-cursor-outline" id="customCursorOutline"></div>

  <style>
  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: #000;
    overflow-x: hidden; /* Only hide horizontal scroll */
    font-family: 'Lato', sans-serif;
  }
  
  /* Hide old headers completely */
  .topbar-chintamani, .site-header {
    display: none !important;
  }

  /* =====================
     HD ANIMATED HEADER
     ===================== */
    .nm-nav-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    border-bottom: none;
    overflow: visible; /* Changed from hidden so mobile menu can drop down */
  }

  /* Only on non-home pages, inject the blurred cave background */
  body:not([data-lang]) .nm-nav-header::before,
  body[data-lang] .nm-nav-header::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url(/images/final_page_no_text.jpg) center top / cover no-repeat;
    z-index: -2;
    opacity: <%= currentTabName === 'home' ? '0' : '1' %>;
  }
  
  .nm-nav-header::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 40px 10px rgba(0,0,0,0.6), inset 0 -80px 60px -20px rgba(0,0,0,1);
    z-index: -1;
    pointer-events: none;
  }


  .nm-logo-container {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .nm-logo-container:hover {
    transform: scale(1.02);
  }

  .nm-nav-logo {
    width: 70px;
    height: 70px;
  }

  .nm-hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    z-index: 101;
  }
  .nm-hamburger span {
    display: block;
    width: 21px;
    height: 2px;
    background: linear-gradient(135deg, #FDE047, #EAB308, #CA8A04);
    box-shadow: 0 0 6px rgba(234, 179, 8, 0.7);
    border-radius: 3px;
    transition: all 0.3s ease;
  }


  .nm-trishul-icon {
    width: 32px;
    height: 42px;
    fill: none;
    stroke: #D4AF37;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 5px rgba(212,175,55,0.5));
  }

  .nm-logo-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nm-logo-title {
    font-family: 'Baloo 2', sans-serif;
    font-size: min(1.2rem, 1.8vw);
    font-weight: 700;
    color: #F4EDE0;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
    white-space: nowrap;
  }

  .nm-logo-subtitle {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    color: #D4AF37;
    letter-spacing: 3px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nm-logo-subtitle::before, .nm-logo-subtitle::after {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background-color: rgba(212, 175, 55, 0.5);
  }

  .nm-nav-links {
    display: flex;
    gap: 40px;
  }

  .nm-nav-links a {
    position: relative;
    font-size: 0.9rem;
    color: #d1cbc0;
    text-decoration: none;
    letter-spacing: 1px;
    font-weight: 400;
    transition: color 0.3s ease;
    padding: 5px 0;
  }

  /* Animated underline effect */
  .nm-nav-links a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 50%;
    background-color: #D4AF37;
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nm-nav-links a:hover, .nm-nav-links a.active {
    color: #D4AF37;
    text-shadow: 0 0 8px rgba(212,175,55,0.4);
  }
  
  .nm-nav-links a:hover::after, .nm-nav-links a.active::after {
    width: 100%;
  }

  /* Donate Button Animation */
  .nm-donate-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #D4AF37;
    border-radius: 25px;
    padding: 8px 24px;
    color: #D4AF37;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }

  .nm-donate-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent);
    transition: all 0.5s ease;
  }

  .nm-donate-btn:hover {
    background: rgba(212, 175, 55, 0.1);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
    color: #FFF;
  }
  
  .nm-donate-btn:hover::before {
    left: 100%;
  }

  .container-wrapper {
    width: 100%;
    display: block;
    position: relative;
  }

  .image-container {
    position: relative;
    width: 100vw;
    height: auto;
    overflow: hidden; /* Prevent scrollbars when background scales */
  }
  
  @keyframes ambient-environment {
    0% {
      transform: scale(1);
      filter: brightness(1);
    }
    25% {
      filter: brightness(1.15); /* Stronger flicker */
    }
    50% {
      transform: scale(1.08); /* More noticeable zoom */
      filter: brightness(0.85); /* Darker shadow */
    }
    75% {
      filter: brightness(1.1);
    }
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
  }
  
  /* Fire Glow Animation */
  
  @keyframes fire-flicker-no-move {
    0% { opacity: 0.5; filter: blur(3px); transform: scale(0.98); }
    25% { opacity: 0.6; filter: blur(4px); transform: scale(1.02); }
    50% { opacity: 0.9; filter: blur(2px); transform: scale(0.95); }
    75% { opacity: 0.7;  transform: scale(1.05); }
    100% { opacity: 0.8; filter: blur(4px); }
  }

  @keyframes fire-flicker {
    0% { opacity: 0.8; filter: blur(4px); }
    25% { opacity: 1; filter: blur(6px); transform: scale(1.15) translate(-40%, -40%); }
    50% { opacity: 0.9; filter: blur(3px); transform: scale(0.9) translate(-60%, -60%); }
    75% { opacity: 0.7;  transform: scale(1.05) translate(-45%, -45%); }
    100% { opacity: 0.8; filter: blur(4px); }
  }

  .fire-glow {
    position: absolute;
    width: 8vw; /* Scales with screen */
    height: 8vw;
    background: radial-gradient(circle, rgba(255, 180, 50, 0.9) 0%, rgba(255, 70, 0, 0.5) 40%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 15;
    mix-blend-mode: screen;
    animation: fire-flicker 2s infinite alternate;
    /* Removed default top/left, it's now handled by JS for perfect alignment */
  }

  .image-container img.bg-image {
    width: 100%;
    height: auto;
    display: block;
  }

    .hd-devi-wrapper {
    position: absolute;
    top: 12.31%;
    left: 50.58%;
    width: 34.86%;
    z-index: 5;
    pointer-events: none;
    /* Ambient occlusion and ground shadow */
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.85)) drop-shadow(0 5px 15px rgba(0,0,0,0.6));
  }

  .hd-devi {
    display: block;
    width: 100%;
    height: auto;
    /* Photorealistic color grading: warm, slightly darker, matching cave */
    filter: sepia(0.35) brightness(0.9) contrast(1.15) saturate(1.2) hue-rotate(-5deg);
  }

  /* Photorealistic localized highlights and rim lighting via masking */
  .hd-devi-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    
    -webkit-mask-image: url('/devi-idol.png');
    mask-image: url('/devi-idol.png');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    
    /* Left and right warm firelight rim bounces, plus bottom darkening */
    background: 
      radial-gradient(ellipse at -10% 60%, rgba(255, 150, 30, 0.6) 0%, transparent 45%),
      radial-gradient(ellipse at 110% 60%, rgba(255, 150, 30, 0.5) 0%, transparent 45%),
      linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.3) 10%, transparent 25%);
    
    mix-blend-mode: overlay;
    z-index: 6;
    pointer-events: none;
  }

  /* Overlay for rest of buttons */
  .button-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }
  
  /* New Action Buttons */
  .action-buttons-container {
    display: flex;
    justify-content: flex-start;
    gap: 20px;
    margin-top: 15px;
    z-index: 20;
  }

  .glow-btn {
    background: <%= currentTabName === 'home' ? 'rgba(0,0,0,0.2)' : 'rgba(21, 19, 15, 0.7)' %>; /* Removed background glow */
