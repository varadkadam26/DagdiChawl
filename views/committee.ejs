<%- include('partials/header') %>

  <style>
    .committee-section {
      background: transparent;
      padding: clamp(170px, 15vw, 210px) 0 5rem;
    }

    .committee-heading {
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .committee-heading h2 {
      font-size: 2.2rem;
      color: var(--gold-soft);
      margin-bottom: 0.5rem;
    }

    .committee-heading p {
      color: var(--text-muted);
      font-size: 1rem;
    }

    .committee-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .committee-card {
      position: relative;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(212, 175, 55, 0.15);
      border-top: 4px solid var(--royal-gold);
      border-radius: var(--radius-lg);
      padding: 2rem 1.5rem;
      text-align: center;
      box-shadow: var(--shadow-sm);
      min-height: 310px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .committee-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow-md);
    }

    .committee-number {
      position: absolute;
      top: 14px;
      right: 14px;

      width: 38px;
      height: 38px;

      border-radius: 50%;

      background: var(--temple-maroon);
      color: var(--gold-soft);

      display: flex;
      align-items: center;
      justify-content: center;

      font-size: 0.9rem;
      font-weight: 800;
    }

    .committee-icon {
      width: 90px;
      height: 90px;

      border-radius: 50%;
      border: 3px solid var(--royal-gold);

      background: linear-gradient(125deg, #050403 0%, #100A07 38%, #28140C 72%, #422315 100%);

      display: flex;
      align-items: center;
      justify-content: center;

      margin: 0 auto 1.2rem;
    }

    .committee-icon i {
      font-size: 2.5rem;
      color: var(--temple-maroon);
    }


    .committee-name-marathi {
      font-family: var(--font-mr, "Baloo 2", serif);
      color: var(--gold-soft);
      font-size: 1.2rem;
      font-weight: 800;
      line-height: 1.5;
      margin-bottom: 0.25rem;
    }

    .committee-name-english {
      color: rgba(255, 255, 255, 0.85);
      font-family: var(--font-en, "Outfit", sans-serif);
      font-size: 0.95rem;
      font-weight: 700;
      line-height: 1.5;
      margin-bottom: 0.8rem;
    }

    .committee-designation-marathi {
      color: rgba(212, 175, 55, 0.9);
      font-family: var(--font-mr, "Baloo 2", serif);
      font-size: 1rem;
      font-weight: 800;
      line-height: 1.5;
    }

    .committee-designation-english {
      color: rgba(255, 255, 255, 0.6);
      font-family: var(--font-en, "Outfit", sans-serif);
      font-size: 0.85rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .committee-divider {
      width: 70%;
      height: 1px;
      background: rgba(212, 175, 55, 0.2);
      margin: 0.7rem auto;
    }

    .committee-note {
      margin-top: 3.5rem;

      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(212, 175, 55, 0.15);
      border-radius: var(--radius-lg);

      padding: 2rem;

      text-align: center;

      box-shadow: var(--shadow-sm);
    }

    .committee-note h3 {
      color: var(--gold-soft);
      margin-bottom: 0.7rem;
    }

    .committee-note p {
      color: rgba(255, 255, 255, 0.75);
      margin: 0;
      line-height: 1.8;
    }


    @media (max-width: 1000px) {

      .committee-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

    }


    @media (max-width: 650px) {

      .committee-section {
        padding: clamp(160px, 20vw, 185px) 0 3.5rem;
      }

      .committee-grid {
        grid-template-columns: 1fr;
        gap: 1.2rem;
      }

      .committee-card {
        min-height: auto;
        padding: 1.8rem 1.2rem;
      }

      .committee-name-marathi {
        font-size: 1.1rem;
      }

    }

    /* Adharsthambh (Our Pillars of Support) Styling */
    .adharsthambh-grid {
      display: flex;
      justify-content: center;
      margin-bottom: 2.5rem;
    }

    .adharsthambh-card {
      border: 1.5px solid rgba(212, 175, 55, 0.35);
      border-top: 4px solid var(--royal-gold);
      background: rgba(25, 14, 10, 0.65);
      backdrop-filter: blur(10px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 175, 55, 0.15);
      padding: 2.2rem 1.5rem;
      border-radius: var(--radius-lg);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      max-width: 420px;
      width: 100%;
    }

    .adharsthambh-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 25px rgba(212, 175, 55, 0.3);
      border-color: rgba(212, 175, 55, 0.6);
    }

    .adharsthambh-img-box {
      width: 145px;
      height: 145px;
      border-radius: 50%;
      border: 3.5px solid var(--royal-gold);
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.45);
      overflow: hidden;
      margin: 0 auto 1.3rem;
      background: #000;
      position: relative;
    }

    .adharsthambh-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.4s ease;
    }

    .adharsthambh-card:hover .adharsthambh-img {
      transform: scale(1.08);
    }

    @media (max-width: 850px) {
      .adharsthambh-card {
        max-width: 100%;
      }
    }
  </style>


  <!-- ==========================================
     COMMITTEE HERO
========================================== -->

<!-- Wrap everything in the gradient background -->
<div style="background: linear-gradient(125deg, #050403 0%, #100A07 38%, #28140C 72%, #422315 100%); min-height: 100vh;">

  <!-- ==========================================
     COMMITTEE MEMBERS
========================================== -->

  <section class="committee-section">

    <div class="container">


      <!-- ==========================================
         AMCHE ADHARSTHAMBH (OUR PILLARS OF SUPPORT)
      ========================================== -->
      <div class="committee-heading" style="margin-bottom: 2.5rem;">
        <h2 class="committee-name-marathi lang-mr" style="color: #ffffff; text-shadow: 0 0 14px rgba(212, 175, 55, 0.9), 0 0 28px rgba(212, 175, 55, 0.5); font-size: 2.3rem; font-weight: 800; font-family: var(--font-mr, 'Baloo 2', serif);">आमचे आधारस्तंभ</h2>
        <h2 class="committee-name-english lang-en" style="color: #ffffff; text-shadow: 0 0 14px rgba(212, 175, 55, 0.9), 0 0 28px rgba(212, 175, 55, 0.5); font-weight: 800; font-family: var(--font-en, 'Outfit', sans-serif); font-size: 2.3rem;">Our Pillars of Support</h2>
        <div class="gold-divider"></div>
      </div>

      <div class="adharsthambh-grid">
        <!-- Arun Bhai Gawli (Daddy) -->
        <div class="committee-card adharsthambh-card">
          <div class="adharsthambh-img-box">
            <img src="/images/committee/arun_gawli_daddy.png" alt="Hon.Shri. Arun Bhai Gawli (Daddy) - माजी आमदार" class="adharsthambh-img" style="object-position: center 15%;">
          </div>
          <div class="committee-name-marathi lang-mr" style="font-size: 1.25rem; font-weight: 800; color: #FFF; text-shadow: 0 0 10px rgba(212, 175, 55, 0.6); margin-bottom: 0.35rem; line-height: 1.4;">
            मा. श्री. अरुण भाई गवळी (डॅडी) - माजी आमदार
          </div>
          <div class="committee-name-english lang-en" style="font-size: 1.05rem; font-weight: 700; color: #F4EDE0; margin-bottom: 0.35rem; line-height: 1.4;">
            Hon.Shri. Arun Bhai Gawli (Daddy) - Ex. MLA
          </div>
        </div>
      </div>

      <div class="gold-divider" style="max-width: 500px; margin: 0 auto 3.8rem; opacity: 0.65;"></div>

      <div class="committee-heading">

        <h2 class="committee-name-marathi lang-mr" style="color: #ffffff; text-shadow: 0 0 12px rgba(212, 175, 55, 0.8), 0 0 24px rgba(212, 175, 55, 0.4);">मंडळाचे पदाधिकारी</h2>
        <h2 class="committee-name-english lang-en" style="color: #ffffff; text-shadow: 0 0 12px rgba(212, 175, 55, 0.8), 0 0 24px rgba(212, 175, 55, 0.4); font-weight: 800; font-family: var(--font-en, 'Outfit', sans-serif);">Mandal Office Bearers</h2>
        
        <p class="committee-name-marathi lang-mr" style="color: #ffffff; text-shadow: 0 0 8px rgba(212, 175, 55, 0.6); font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0;">
          सन २०२६-२७ साठी नियुक्त पदाधिकारी
        </p>
        <p class="committee-name-english lang-en" style="color: #ffffff; text-shadow: 0 0 8px rgba(212, 175, 55, 0.6); font-size: 1.1rem; max-width: 600px; margin: 0.5rem auto 0; font-family: var(--font-en, 'Outfit', sans-serif);">
          Office Bearers for the Year 2026-27
        </p>

        <div class="gold-divider"></div>

      </div>



      <div class="committee-grid">


        <% committeeData.forEach(member=> { %>


          <div class="committee-card">


            <!-- NUMBER -->

            <div class="committee-number">
              <%= member.number %>
            </div>


            <!-- MEMBER ICON -->

            <div class="committee-icon" style="<%= member.noBorder ? 'border: none; background: transparent;' : '' %> overflow: hidden; -webkit-mask-image: -webkit-radial-gradient(white, black); border-radius: 50%;">
              <% if (member.image) { %>
                <img src="<%= member.image %>" alt="<%= member.nameEn %>" style="width: 100%; height: 100%; object-fit: <%= member.objectFit || 'cover' %>; object-position: <%= member.objectPosition || 'center' %>; <%= member.customTransform ? 'transform: ' + member.customTransform + ';' : '' %>">
              <% } else { %>
                <i class="fa-solid fa-user-tie"></i>
              <% } %>
            </div>


            <!-- MARATHI NAME -->

            <div class="committee-name-marathi lang-mr">
              <%= member.nameMr %>
            </div>


            <!-- ENGLISH NAME -->

            <div class="committee-name-english lang-en">
              <%= member.nameEn %>
            </div>


            <div class="committee-divider"></div>


            <!-- MARATHI DESIGNATION -->

            <div class="committee-designation-marathi lang-mr">
              <%= member.designationMr %>
            </div>


            <div class="committee-designation-english lang-en">
              <%= member.designationEn %>
            </div>

            <!-- PHONE -->
            <% if (member.phone) { %>
            <div class="committee-phone" style="margin-top: 0.8rem; font-size: 0.9rem; color: var(--gold-soft); font-family: var(--font-en, 'Outfit', sans-serif);">
              <i class="fa-solid fa-phone" style="font-size: 0.8rem; margin-right: 0.4rem;"></i>
              <a href="tel:<%= member.phone %>" style="color: inherit; text-decoration: none;"><%= member.phone %></a>
            </div>
            <% } %>


          </div>


          <% }); %>


      </div>



      <!-- INFORMATION NOTE -->

      <div class="committee-note">
        <h3 class="committee-name-marathi lang-mr">टीप</h3>
        <h3 class="committee-name-english lang-en" style="font-family: var(--font-en, 'Outfit', sans-serif);">Note</h3>
        <p class="committee-name-marathi lang-mr">
          वरील पदाधिकारी मंडळाच्या सन २०२६-२७ च्या कार्यकारिणीचा भाग आहेत.
        </p>
        <p class="committee-name-english lang-en">
          The above members are part of the executive committee 
          for the year 2026-27.
        </p>
      </div>


  </section>
</div>

  <%- include('partials/footer') %>