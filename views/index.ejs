<%- include('partials/header') %>
<style>
  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: #050403;
    overflow-x: hidden; /* Only hide horizontal scroll */
    font-family: 'Baloo 2', sans-serif;
  }
  
  /* Hide old headers completely */
  .topbar-chintamani, .site-header {
    display: none !important;
  }

  /* =====================
     HD ANIMATED HEADER
     ===================== */
  .nm-nav-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    /* justify-content: space-between; removed for top bar */
    align-items: center;
    /* padding: 24px 5%; removed for top bar */
    box-sizing: border-box;
    background: transparent;
    border-bottom: none;
  }

  .nm-logo-container {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .nm-logo-container:hover {
    transform: scale(1.02);
  }

  .nm-nav-logo {
    width: 70px;
    height: 70px;
  }

  .nm-hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    z-index: 101;
  }
  .nm-hamburger span {
    display: block;
    width: 21px;
    height: 2px;
    background: linear-gradient(135deg, #FDE047, #EAB308, #CA8A04);
    box-shadow: 0 0 6px rgba(234, 179, 8, 0.7);
    border-radius: 3px;
    transition: all 0.3s ease;
  }


  .nm-trishul-icon {
    width: 32px;
    height: 42px;
    fill: none;
    stroke: #D4AF37;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 5px rgba(212,175,55,0.5));
  }

  .nm-logo-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .nm-logo-title {
    font-family: 'Baloo 2', sans-serif;
    font-size: min(1.2rem, 1.8vw);
    font-weight: 700;
    color: #F4EDE0;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
    white-space: nowrap;
  }

  .nm-logo-subtitle {
    font-family: 'Baloo 2', sans-serif;
    font-size: 0.65rem;
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    letter-spacing: 3px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nm-logo-subtitle::before, .nm-logo-subtitle::after {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background-color: rgba(212, 175, 55, 0.5);
  }

  .nm-nav-links {
    display: flex;
    gap: 40px;
  }

  .nm-nav-links a {
    position: relative;
    font-size: 0.9rem;
    color: #d1cbc0;
    text-decoration: none;
    letter-spacing: 1px;
    font-weight: 700;
    transition: color 0.3s ease;
    padding: 5px 0;
  }

  /* Animated underline effect */
  .nm-nav-links a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 50%;
    background-color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nm-nav-links a:hover, .nm-nav-links a.active {
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    text-shadow: 0 0 8px rgba(212,175,55,0.4);
  }
  
  .nm-nav-links a:hover::after, .nm-nav-links a.active::after {
    width: 100%;
  }

  /* Donate Button Animation */
  .nm-donate-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #D4AF37;
    border-radius: 25px;
    padding: 8px 24px;
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }

  .nm-donate-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent);
    transition: all 0.5s ease;
  }

  .nm-donate-btn:hover {
    background: rgba(212, 175, 55, 0.1);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
    color: #FFF;
  }
  
  .nm-donate-btn:hover::before {
    left: 100%;
  }

  .container-wrapper {
    width: 100%;
    display: block;
    position: relative;
  }

  .image-container {
    position: relative;
    width: 100vw;
    height: auto;
    overflow: hidden; /* Prevent scrollbars when background scales */
  }
  
  @keyframes ambient-environment {
    0% {
      transform: scale(1);
      filter: brightness(1);
    }
    25% {
      filter: brightness(1.15); /* Stronger flicker */
    }
    50% {
      transform: scale(1.08); /* More noticeable zoom */
      filter: brightness(0.85); /* Darker shadow */
    }
    75% {
      filter: brightness(1.1);
    }
    100% {
      transform: scale(1);
      filter: brightness(1);
    }
  }
  
  /* Fire Glow Animation */
  
  @keyframes fire-flicker-no-move {
    0% { opacity: 0.5; filter: blur(3px); transform: scale(0.98); }
    25% { opacity: 0.6; filter: blur(4px); transform: scale(1.02); }
    50% { opacity: 0.9; filter: blur(2px); transform: scale(0.95); }
    75% { opacity: 0.7; filter: blur(5px); transform: scale(1.05); }
    100% { opacity: 0.8; filter: blur(4px); }
  }

  @keyframes fire-flicker {
    0% { opacity: 0.8; filter: blur(4px); }
    25% { opacity: 1; filter: blur(6px); transform: scale(1.15) translate(-40%, -40%); }
    50% { opacity: 0.9; filter: blur(3px); transform: scale(0.9) translate(-60%, -60%); }
    75% { opacity: 0.7; filter: blur(5px); transform: scale(1.05) translate(-45%, -45%); }
    100% { opacity: 0.8; filter: blur(4px); }
  }

  .fire-glow {
    position: absolute;
    width: 8vw; /* Scales with screen */
    height: 8vw;
    background: radial-gradient(circle, rgba(255, 180, 50, 0.9) 0%, rgba(255, 70, 0, 0.5) 40%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 15;
    mix-blend-mode: screen;
    animation: fire-flicker 2s infinite alternate;
    /* Removed default top/left, it's now handled by JS for perfect alignment */
  }

  .image-container img.bg-image {
    width: 104%;
    max-width: none;
    height: auto;
    display: block;
    transform: translateX(2.2%);
  }

  /* ============================================================
     PROMINENT MOVING GOLDEN GLOW AROUND & BEHIND DEVI MAA
     ============================================================ */
  .devi-divine-aura {
    position: absolute;
    top: 25.5%;
    left: 70.2%;
    width: 46vw;
    height: 38vw;
    transform: translate(-50%, -50%);
    z-index: 4;
    pointer-events: none;
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  /* Core breathing pulsating golden radiance - diffuse, organic, NOT a geometric circle */
  .devi-aura-core {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 30%;
    background: radial-gradient(ellipse 65% 55% at 50% 50%, rgba(212, 175, 55, 0.4) 0%, rgba(197, 160, 40, 0.22) 40%, rgba(184, 134, 11, 0.1) 65%, transparent 85%);
    mix-blend-mode: screen;
    animation: deviAuraPulse 3.5s ease-in-out infinite alternate;
    filter: blur(35px);
  }

  .devi-aura-rays {
    display: none; /* Removed geometric circular rays */
  }

  /* Soft atmospheric golden shimmer wash */
  .devi-aura-shimmer {
    position: absolute;
    width: 120%;
    height: 120%;
    border-radius: 35%;
    background: radial-gradient(ellipse 70% 60% at 50% 50%, rgba(212, 175, 55, 0.18) 0%, rgba(180, 130, 20, 0.08) 50%, transparent 75%);
    mix-blend-mode: screen;
    animation: deviShimmerFloat 4s ease-in-out infinite alternate;
    filter: blur(45px);
  }

  @keyframes deviAuraPulse {
    0% {
      transform: scale(0.95);
      opacity: 0.45;
      filter: blur(14px) drop-shadow(0 0 14px rgba(212, 175, 55, 0.3));
    }
    50% {
      transform: scale(1.05);
      opacity: 0.65;
      filter: blur(18px) drop-shadow(0 0 22px rgba(197, 160, 40, 0.45));
    }
    100% {
      transform: scale(0.97);
      opacity: 0.5;
      filter: blur(15px) drop-shadow(0 0 16px rgba(212, 175, 55, 0.35));
    }
  }

  @keyframes deviRaysRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes deviShimmerFloat {
    0% {
      transform: scale(0.96) translateY(3px);
      opacity: 0.45;
    }
    100% {
      transform: scale(1.08) translateY(-5px);
      opacity: 0.7;
    }
  }

  .hd-devi-wrapper {
    display: block !important;
    position: absolute;
    top: 16.72%;
    left: 53.48%;
    width: 35.99%;
    z-index: 5;
    pointer-events: none;
    filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.3)) drop-shadow(0 0 20px rgba(212, 175, 55, 0.2));
  }

  .hd-devi {
    display: block;
    width: 100%;
    height: auto;
    filter: sepia(0.18) brightness(0.98) contrast(1.14) saturate(1.18);
  }

  /* Photorealistic localized highlights and rim lighting via masking */
  .hd-devi-wrapper::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    
    -webkit-mask-image: url('/devi-idol.png');
    mask-image: url('/devi-idol.png');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    
    /* Left and right warm firelight rim bounces */
    background: 
      radial-gradient(ellipse at -10% 60%, rgba(255, 150, 30, 0.5) 0%, transparent 45%),
      radial-gradient(ellipse at 110% 60%, rgba(255, 150, 30, 0.4) 0%, transparent 45%);
    
    mix-blend-mode: overlay;
    z-index: 6;
    pointer-events: none;
  }

  /* Overlay for rest of buttons */
  .button-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }
  
  /* New Action Buttons */
  .action-buttons-container {
    display: flex;
    justify-content: flex-start;
    gap: 20px;
    margin-top: 15px;
    z-index: 20;
  }

  .glow-btn {
    background: transparent; /* Removed background glow */
    color: #F4EDE0;
    font-family: 'Baloo 2', sans-serif; /* Changed to Baloo 2 */
    font-size: 1.1rem;
    font-weight: 700; /* Bold */
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 10px 25px;
    text-decoration: none;
    border-radius: 40px;
    border: 1px solid #D4AF37; /* Very thin gold border */
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.6), inset 0 0 5px rgba(212, 175, 55, 0.3); /* Glowy gold border */
    transition: all 0.3s ease;
  }
  
  .glow-btn:hover {
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.9), inset 0 0 10px rgba(212, 175, 55, 0.5);
    background: rgba(212, 175, 55, 0.1);
    color: #FFF;
    transform: scale(1.05);
  }

  .invisible-btn {
    position: absolute;
    display: block;
    cursor: pointer;
    z-index: 10;
  }

  /* HD Text Overlay Styles */
  .hd-text-container {
    position: absolute;
    top: 35%;
    left: 8%;
    width: 45%;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hd-eyebrow {
    font-size: 0.9vw;
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    letter-spacing: 0.4vw;
    text-transform: uppercase;
    margin-bottom: 1vw;
    font-weight: 700;
    text-shadow: 0 2px 5px rgba(0,0,0,0.8);
  }

  .hd-main-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5vw;
    color: #F4EDE0;
    line-height: 1.1;
    margin: 0 0 1.5vw 0;
    font-weight: 700;
    white-space: nowrap;
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.9), 0 0 40px rgba(212, 175, 55, 0.7), 2px 5px 15px rgba(0,0,0,0.8);
  }

  .hd-keywords {
    font-size: 1vw;
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    letter-spacing: 0.3vw;
    margin-bottom: 2vw;
    text-transform: uppercase;
    text-shadow: 0 2px 5px rgba(0,0,0,0.8);
  }

  .hd-quote {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 1.2vw;
    color: #A8A196;
    line-height: 1.8;
    margin-bottom: 3vw;
    text-shadow: 0 2px 5px rgba(0,0,0,0.8);
  }

  .hd-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #D4AF37;
    border-radius: 30px;
    padding: 1vw 2.5vw;
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4);;
    text-decoration: none;
    font-size: 1vw;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    background: rgba(5, 5, 6, 0.6);
    position: relative;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.5);
  }

  .hd-explore-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent);
    transition: all 0.5s ease;
  }

  .hd-explore-btn:hover {
    background: rgba(212, 175, 55, 0.1);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.6);
    color: #FFF;
  }

  .hd-explore-btn:hover::before {
    left: 100%;
  }

  /* =====================
     MOBILE OPTIMIZATION
     ===================== */
  @media (max-width: 768px) {
    /* Fix extracted layout sections for mobile */
    .grid-2 {
      display: flex !important;
      flex-direction: column !important;
      gap: 2rem !important;
    }
    .grid-4 {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important; /* Stats counter 2x2 on mobile */
      gap: 1rem !important;
    }
    section[style*="padding: 6rem 0"] {
      padding: 3rem 0 !important; /* Reduce massive desktop padding on mobile */
    }

    /* Adjust header for mobile */
    .nm-nav-header {
      /* padding: 18px 5%; removed for top bar */
      background: transparent !important;
    }
    .nm-nav-links {
      display: none; 
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: rgba(25, 18, 12, 0.98);
      /* No backdrop blur so it matches exactly */
      padding: 20px 5%;
      border-bottom: none;
      box-sizing: border-box;
      gap: 20px;
    }
    .nm-nav-links.active {
      display: flex;
    }
    .nm-hamburger {
      display: flex !important;
      flex-direction: column;
      gap: 5px;
      padding: 6px;
      cursor: pointer;
    }
    .nm-hamburger span {
      display: block;
      width: 24px;
      height: 2.5px;
      background: #D4AF37 !important;
      box-shadow: 0 0 8px rgba(212, 175, 55, 0.6) !important;
      border-radius: 3px;
    }
    .nm-nav-logo {
      width: 38px !important;
      height: 38px !important;
      flex-shrink: 0;
    }
    .nm-logo-container {
      display: flex !important;
      align-items: center !important;
      gap: 8px !important;
      max-width: calc(100% - 50px) !important;
      text-decoration: none !important;
    }
    .nm-trishul-icon {
      width: 22px;
      height: 30px;
    }
    .nm-logo-text {
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      overflow: hidden !important;
      flex: 1;
    }
    .nm-logo-title {
      font-family: 'Baloo 2', sans-serif !important;
      font-weight: 700 !important;
      font-size: clamp(10.5px, 2.9vw, 13px) !important;
      line-height: 1.2 !important;
      color: #F4EDE0 !important;
      text-shadow: 0 0 10px rgba(212, 175, 55, 0.4), 1px 1px 3px rgba(0, 0, 0, 0.8) !important;
      white-space: normal !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      letter-spacing: 0.3px !important;
    }
    .nm-donate-btn {
      display: none; /* Hide on mobile to fit long title */
    }
    .president-img {
      height: auto !important;
    }

    /* Reset container layout */
    .container-wrapper {
      height: auto;
    }
    .image-container {
      height: 100vh;
      display: block;
      background: none;
      overflow: hidden;
      position: relative;
    }
    
    .image-container picture {
      display: block;
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: absolute;
      top: 0;
      left: 0;
    }

    /* 1. First Section: Full Screen Devi Image - Shifted a bit to the right */
    .image-container img.bg-image {
      display: block;
      width: 108% !important;
      max-width: none !important;
      height: 100vh !important;
      object-fit: cover !important;
      object-position: center center !important;
      margin-left: -4% !important;
      transform: translateX(3.5%) !important;
    }

    /* Complete removal of oval/ellipse aura - 0% oval */
    .devi-divine-aura {
      display: none !important;
    }

    /* Golden glow strictly outlining the border of Devi photo - NOT an oval */
    .hd-devi-wrapper {
      display: block !important;
      position: absolute !important;
      top: 23.7vh !important;
      left: calc(53.78% - 2.075vh) !important;
      width: 37.5vh !important;
      height: 46.6vh !important;
      transform: translate(-50%, 0) !important;
      z-index: 5 !important;
      pointer-events: none !important;
      animation: deviPhotoBorderGlow 3.5s ease-in-out infinite alternate !important;
    }

    .hd-devi-wrapper picture,
    .hd-devi-wrapper img.hd-devi {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
    }

    @keyframes deviPhotoBorderGlow {
      0% {
        filter: drop-shadow(0 0 3px rgba(255, 215, 0, 0.45)) drop-shadow(0 0 7px rgba(212, 175, 55, 0.3)) drop-shadow(0 0 12px rgba(212, 175, 55, 0.18));
      }
      50% {
        filter: drop-shadow(0 0 4px rgba(255, 215, 0, 0.6)) drop-shadow(0 0 10px rgba(212, 175, 55, 0.4)) drop-shadow(0 0 16px rgba(212, 175, 55, 0.25));
      }
      100% {
        filter: drop-shadow(0 0 3px rgba(255, 215, 0, 0.45)) drop-shadow(0 0 7px rgba(212, 175, 55, 0.3)) drop-shadow(0 0 12px rgba(212, 175, 55, 0.18));
      }
    }

    /* 2. Second Section: Text below the image */
    .hd-text-container {
      position: absolute; /* Overlay on the image */
      top: 17vh; /* Properly spaced below top navigation title */
      left: 0;
      right: 0;
      width: 100%;
      margin: 0 auto;
      padding: 0 15px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: transparent; /* Keep the cave as the background */
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: none;
      border-radius: 0;
      z-index: 20;
    }

    /* Mobile Lamp Placements - Hide floating glow dot */
    .fire-glow {
      display: none !important;
    }
    
    /* Proper rem sizing for mobile */
    .hd-eyebrow {
      display: none; /* Hide in mobile so the title is immediately below the image */
    }
    .hd-main-title {
      font-family: 'Baloo 2', sans-serif; /* Applied Baloo 2 font */
      font-weight: 700; /* Bold */
      font-size: clamp(14px, 4.6vw, 18.5px); /* A bit smaller to fit cleanly in one single line on mobile */
      width: 100%;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      white-space: nowrap; /* Forces one line */
      /* Added a slight gold glow behind it while preserving readability */
      text-shadow: 0 0 25px rgba(212, 175, 55, 1), 0 0 45px rgba(212, 175, 55, 0.8), 2px 2px 10px rgba(0, 0, 0, 0.9); 
    }
    .hd-main-title span {
      display: inline-block;
      text-align: center;
      margin: 0 auto;
    }
    
    /* Hide everything else so ONLY the sentence is shown on the picture */
    .hd-keywords, .hd-quote {
      display: none;
    }

    .action-buttons-container {
      position: absolute;
      top: 73.5vh; /* In the cave background properly spaced below Devi's feet */
      left: 0;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      flex-direction: row;
      margin-top: 0;
      z-index: 25;
    }

    .glow-btn {
      font-size: 0.75rem; /* Made smaller */
      padding: 8px 14px; /* Properly fit into mobile */
      letter-spacing: 1px; /* Less spacing for better fit */
    }

    .button-overlay {
      display: none;
    }
  }


  
  
  
  
  
  @media (max-width: 768px) {
    
    
  }


  .nm-social-icons a:hover {
    color: #CBA135; text-shadow: 0 0 8px rgba(203, 161, 53, 0.4); !important;
  }


  .ios-glass-switch .lang-btn {
    color: rgba(255, 255, 255, 0.5) !important;
  }
  .ios-glass-switch .lang-btn:hover {
    color: rgba(255, 255, 255, 0.8) !important;
  }
  .ios-glass-switch .lang-btn.active {
    background: #050403fff !important;
    color: #1a1a1a !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2) !important;
