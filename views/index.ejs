<%- include('partials/header') %>
<style>
  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    background-color: #000;
    overflow-x: hidden; /* Only hide horizontal scroll */
    font-family: 'Lato', sans-serif;
  }
  
  /* Hide old headers completely */
  .topbar-chintamani, .site-header {
    display: none !important;
  }

  /* =====================
     HD ANIMATED HEADER
     ===================== */
  .nm-nav-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 5%;
    box-sizing: border-box;
    /* Frosted glass to cover any blurry baked-in header */
    background: linear-gradient(to bottom, rgba(5,5,6,0.95), rgba(5,5,6,0.7));
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
  }

  .nm-logo-container {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }
  .nm-logo-container:hover {
    transform: scale(1.02);
  }

  .nm-trishul-icon {
    width: 32px;
    height: 42px;
    fill: none;
    stroke: #D4AF37;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 5px rgba(212,175,55,0.5));
  }

  .nm-logo-text {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .nm-logo-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 500;
    color: #F4EDE0;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .nm-logo-subtitle {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    color: #D4AF37;
    letter-spacing: 3px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nm-logo-subtitle::before, .nm-logo-subtitle::after {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1px;
    background-color: rgba(212, 175, 55, 0.5);
  }

  .nm-nav-links {
    display: flex;
    gap: 40px;
  }

  .nm-nav-links a {
    position: relative;
    font-size: 0.9rem;
    color: #d1cbc0;
    text-decoration: none;
    letter-spacing: 1px;
    font-weight: 400;
    transition: color 0.3s ease;
    padding: 5px 0;
  }

  /* Animated underline effect */
  .nm-nav-links a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: 0;
    left: 50%;
    background-color: #D4AF37;
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .nm-nav-links a:hover, .nm-nav-links a.active {
    color: #D4AF37;
    text-shadow: 0 0 8px rgba(212,175,55,0.4);
  }
  
  .nm-nav-links a:hover::after, .nm-nav-links a.active::after {
    width: 100%;
  }

  /* Donate Button Animation */
  .nm-donate-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid #D4AF37;
    border-radius: 25px;
    padding: 8px 24px;
    color: #D4AF37;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
  }

  .nm-donate-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(212,175,55,0.2), transparent);
    transition: all 0.5s ease;
  }

  .nm-donate-btn:hover {
    background: rgba(212, 175, 55, 0.1);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
    color: #FFF;
  }
  
  .nm-donate-btn:hover::before {
    left: 100%;
  }

  .container-wrapper {
    width: 100%;
    display: block;
    position: relative;
  }

  .image-container {
    position: relative;
    width: 100vw;
    height: auto;
  }
  
  .image-container img.bg-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .hd-devi {
    position: absolute;
    top: 12.31%;
    left: 50.58%;
    width: 34.86%;
    height: auto;
    z-index: 5;
    pointer-events: none; /* Let clicks pass through if needed */
    filter: drop-shadow(0 15px 30px rgba(0,0,0,0.5));
  }

  /* Overlay for rest of buttons */
  .button-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
  }
  
  .invisible-btn {
    position: absolute;
    display: block;
    cursor: pointer;
    z-index: 10;
  }

  .btn-explore { top: 57%; left: 12%; width: 15%; height: 6%; }
</style>

<!-- HD Animated Header -->
<header class="nm-nav-header">
  <a href="/" class="nm-logo-container">
    <svg class="nm-trishul-icon" viewBox="0 0 60 80" xmlns="http://www.w3.org/2000/svg">
      <path d="M30 5 L30 25" stroke-linecap="round"/>
      <path d="M30 25 Q15 20 15 5" stroke-linecap="round"/>
      <path d="M30 25 Q45 20 45 5" stroke-linecap="round"/>
      <text x="30" y="22" font-family="sans-serif" font-size="14" fill="#D4AF37" stroke="none" text-anchor="middle">ॐ</text>
      <line x1="30" y1="25" x2="30" y2="75" stroke-linecap="round"/>
      <line x1="20" y1="35" x2="40" y2="35" stroke-linecap="round"/>
    </svg>
    <div class="nm-logo-text">
      <span class="nm-logo-title">SHREE NAVRATRI MANDAL</span>
      <span class="nm-logo-subtitle">|| Jai Mata Di ||</span>
    </div>
  </a>

  <nav class="nm-nav-links">
    <a href="/" class="active">Home</a>
    <a href="/about">About</a>
    <a href="/schedule">Events</a>
    <a href="/glimpses">Gallery</a>
    <a href="/contact">Contact</a>
  </nav>

  <a href="/donate" class="nm-donate-btn">
    <i class="fa-regular fa-bell" style="font-size: 0.9rem;"></i>
    Donate
  </a>
</header>

<div class="container-wrapper">
  <div class="image-container">
    <!-- Blurry baked background -->
    <img src="/images/final_page.jpg" alt="Shree Navratri Mandal Home" class="bg-image" />
    
    <!-- Razor-sharp HD Devi Idol overlaid EXACTLY on top -->
    <img src="/devi-idol.png" alt="HD Devi" class="hd-devi" />
    
    <div class="button-overlay">
      <a href="/schedule" class="invisible-btn btn-explore" title="Explore More"></a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>