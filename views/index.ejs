<%- include('partials/header') %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Lato:wght@300;400;500;600&display=swap');

  :root {
    --gold: #D4AF37;
    --gold-hover: #F2CA52;
    --warm-light: #FFB700;
    --bg-dark: #0F0F12;
    --text-main: #F4EDE0;
    --text-muted: #A8A196;
  }

  body, html {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background-color: var(--bg-dark);
    font-family: 'Lato', sans-serif;
    color: var(--text-main);
    overflow-x: hidden;
  }

  /* Hide the old topbars if any from header.ejs */
  .topbar-chintamani, .site-header {
    display: none !important;
  }

  /* =====================
     HERO BACKGROUND
     ===================== */
  .hero-wrapper {
    position: relative;
    width: 100%;
    min-height: 100vh;
    /* Use the cave background */
    background-image: url('/images/generated_bg_cave.jpg');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    flex-direction: column;
  }

  /* Gradient overlays for moody atmospheric lighting and text readability */
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      linear-gradient(90deg, rgba(15,15,18,0.95) 0%, rgba(15,15,18,0.7) 45%, rgba(15,15,18,0.2) 100%),
      linear-gradient(to top, rgba(15,15,18,0.9) 0%, transparent 30%);
    pointer-events: none;
    z-index: 1;
  }

  /* =====================
     HEADER & NAV
     ===================== */
  .nm-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 5%;
    box-sizing: border-box;
    /* Semi-transparent dark backdrop blur */
    background: rgba(15, 15, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
  }

  .nm-logo-container {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
  }

  .nm-trishul-icon {
    width: 32px;
    height: 42px;
    fill: none;
    stroke: var(--gold);
    stroke-width: 2.5;
  }

  .nm-logo-text {
    display: flex;
    flex-direction: column;
  }

  .nm-logo-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .nm-logo-subtitle {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 3px;
    margin-top: 3px;
  }

  .nm-nav-links {
    display: flex;
    gap: 40px;
  }

  .nm-nav-links a {
    font-size: 0.9rem;
    color: var(--text-main);
    text-decoration: none;
    letter-spacing: 1px;
    font-weight: 400;
    position: relative;
    padding-bottom: 4px;
    transition: color 0.3s ease;
  }

  .nm-nav-links a:hover, .nm-nav-links a.active {
    color: var(--gold);
  }

  /* Subtle golden underline glow on hover */
  .nm-nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: var(--gold);
    box-shadow: 0 0 8px var(--gold);
    transition: width 0.3s ease;
  }

  .nm-nav-links a:hover::after, .nm-nav-links a.active::after {
    width: 100%;
  }

  .nm-donate-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--gold);
    border-radius: 25px;
    padding: 8px 24px;
    color: var(--gold);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    text-transform: uppercase;
  }

  .nm-donate-btn:hover {
    background: rgba(212, 175, 55, 0.15);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
    color: var(--gold-hover);
  }

  /* =====================
     HERO CONTENT GRID
     ===================== */
  .hero-content-grid {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 45% 55%;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    flex-grow: 1;
    padding: 100px 5% 50px 5%;
    align-items: center;
  }

  /* Left Side - Text */
  .hero-text-col {
    padding-right: 40px;
  }

  .eyebrow-text {
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    color: var(--gold);
    letter-spacing: 4px;
    text-transform: uppercase;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .main-heading {
    font-family: 'Playfair Display', serif;
    font-size: 4.5rem;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 25px 0;
    font-weight: 600;
    text-shadow: 0 5px 15px rgba(0,0,0,0.8);
  }

  .subtext-keywords {
    font-family: 'Lato', sans-serif;
    font-size: 1.1rem;
    color: var(--gold);
    letter-spacing: 4px;
    margin-bottom: 35px;
    text-transform: uppercase;
  }

  .subtext-keywords span {
    color: rgba(212, 175, 55, 0.4);
    margin: 0 12px;
  }

  .quote-text {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.8;
    margin-bottom: 45px;
    max-width: 90%;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--gold);
    border-radius: 30px;
    padding: 14px 35px;
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.95rem;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    background: rgba(15, 15, 18, 0.4);
    backdrop-filter: blur(5px);
  }

  .cta-button:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: var(--gold-hover);
    color: #FFF;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(212, 175, 55, 0.25);
  }

  /* Right Side - Spotlight Frame */
  .hero-image-col {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  /* Dark wooden alcove frame styling */
  .idol-frame {
    position: relative;
    max-width: 85%;
    background: #080706; /* Dark wood/stone base */
    padding: 12px;
    border: 2px solid rgba(212, 175, 55, 0.3);
    border-radius: 8px 8px 0 0;
    box-shadow: 
      inset 0 0 30px rgba(0,0,0,0.9),
      0 20px 50px rgba(0,0,0,0.8),
      0 0 60px rgba(255, 183, 0, 0.15); /* Ambient warm glow behind frame */
  }

  /* The uploaded image */
  .idol-frame img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 75vh;
    object-fit: cover;
    border-radius: 4px 4px 0 0;
    filter: contrast(1.05) saturate(1.05); /* Slight enhancement for realism */
  }

  /* Warm directional light overlay */
  .idol-light-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 183, 0, 0.1) 0%, transparent 50%, rgba(0,0,0,0.4) 100%);
    pointer-events: none;
    border-radius: 4px 4px 0 0;
  }

  /* Floor reflection illusion below the frame */
  .idol-reflection {
    content: '';
    position: absolute;
    bottom: -40px;
    left: 5%;
    width: 90%;
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    filter: blur(15px);
    transform: perspective(200px) rotateX(60deg);
    pointer-events: none;
  }

  /* =====================
     ANIMATIONS & EFFECTS
     ===================== */
  /* Candle flicker */
  .flicker-light {
    position: absolute;
    border-radius: 50%;
    background: var(--warm-light);
    filter: blur(25px);
    opacity: 0.5;
    animation: flicker 3s infinite alternate ease-in-out;
    pointer-events: none;
  }

  .flicker-1 {
    width: 80px;
    height: 80px;
    bottom: 20%;
    left: 10%;
  }

  .flicker-2 {
    width: 120px;
    height: 120px;
    bottom: 10%;
    right: 5%;
    animation-delay: 1s;
    background: #FF8C00;
  }

  @keyframes flicker {
    0%, 100% { opacity: 0.3; transform: scale(0.9); }
    50% { opacity: 0.6; transform: scale(1.1); }
    75% { opacity: 0.4; transform: scale(1.0); }
  }

  /* =====================
     RESPONSIVE DESIGN
     ===================== */
  @media (max-width: 1024px) {
    .main-heading { font-size: 3.5rem; }
    .hero-content-grid { grid-template-columns: 50% 50%; }
    .nm-nav-links { gap: 20px; }
  }

  @media (max-width: 768px) {
    .hero-content-grid {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 120px;
      gap: 40px;
    }

    .hero-text-col {
      padding-right: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .quote-text { max-width: 100%; }

    .nm-nav-links { display: none; /* Hide nav on mobile for simplicity in this demo */ }
    
    .hero-overlay {
      background: linear-gradient(to top, rgba(15,15,18,0.95) 0%, rgba(15,15,18,0.8) 50%, rgba(15,15,18,0.6) 100%);
    }

    .idol-frame { max-width: 90%; }
  }
</style>

<div class="hero-wrapper">
  <div class="hero-overlay"></div>
  
  <!-- Flickering Ambient Lights -->
  <div class="flicker-light flicker-1"></div>
  <div class="flicker-light flicker-2"></div>

  <!-- Header -->
  <header class="nm-nav-header">
    <a href="/" class="nm-logo-container">
      <svg class="nm-trishul-icon" viewBox="0 0 60 80" xmlns="http://www.w3.org/2000/svg">
        <path d="M30 5 L30 25" stroke-linecap="round"/>
        <path d="M30 25 Q15 20 15 5" stroke-linecap="round"/>
        <path d="M30 25 Q45 20 45 5" stroke-linecap="round"/>
        <text x="30" y="22" font-family="sans-serif" font-size="14" fill="#D4AF37" stroke="none" text-anchor="middle">ॐ</text>
        <line x1="30" y1="25" x2="30" y2="75" stroke-linecap="round"/>
        <line x1="20" y1="35" x2="40" y2="35" stroke-linecap="round"/>
      </svg>
      <div class="nm-logo-text">
        <span class="nm-logo-title">SHREE NAVRATRI MANDAL</span>
        <span class="nm-logo-subtitle">|| EST. 1995 ||</span>
      </div>
    </a>

    <nav class="nm-nav-links">
      <a href="/" class="active">Home</a>
      <a href="/about">About</a>
      <a href="/schedule">Events</a>
      <a href="/glimpses">Gallery</a>
      <a href="/contact">Contact</a>
    </nav>

    <a href="/donate" class="nm-donate-btn">
      <i class="fa-solid fa-heart" style="font-size: 0.9rem;"></i>
      Donate
    </a>
  </header>

  <!-- Hero Content Grid -->
  <div class="hero-content-grid">
    
    <!-- Left: Text Content -->
    <div class="hero-text-col">
      <div class="eyebrow-text">WELCOME TO SHREE NAVRATRI MANDAL (EST. 1995)</div>
      
      <h1 class="main-heading">Shree Navratri<br>Mandal</h1>
      
      <div class="subtext-keywords">
        Faith <span>|</span> Unity <span>|</span> Celebration
      </div>
      
      <p class="quote-text">
        "May the divine energy of Maa Durga fill your life with happiness, prosperity and strength."
      </p>
      
      <a href="#events" class="cta-button">
        Discover More Events &nbsp;&nbsp;&rarr;
      </a>
    </div>

    <!-- Right: Main Idol Spotlight -->
    <div class="hero-image-col">
      <div class="idol-frame">
        <img src="/images/devi-idol.jpg" alt="Shree Navratri Mandal Maa Durga" loading="eager" />
        <div class="idol-light-overlay"></div>
      </div>
      <div class="idol-reflection"></div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>