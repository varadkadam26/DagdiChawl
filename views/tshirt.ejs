<%- include('partials/header') %>

<style>
  body {
    background: linear-gradient(135deg, #180D06 0%, #28140C 40%, #422315 75%, #100A07 100%) !important;
    min-height: 100vh;
  }
  .main-content-gradient {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: clamp(170px, 15vw, 210px) 0 4rem !important;
  }

  @media (max-width: 768px) {
    .main-content-gradient {
      padding: clamp(150px, 18vw, 180px) 0 3.5rem !important;
    }
  }
  
  .tshirt-showcase-card {
    background: transparent !important;
    border: 1px solid rgba(212, 175, 55, 0.35) !important;
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.18), 0 10px 30px rgba(0, 0, 0, 0.5) !important;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.8rem);
    text-align: center;
    margin: 0 auto;
    max-width: 650px;
    transition: all 0.3s ease;
  }

  .tshirt-showcase-card:hover {
    border-color: rgba(212, 175, 55, 0.6) !important;
    box-shadow: 0 0 28px rgba(212, 175, 55, 0.28), 0 12px 35px rgba(0, 0, 0, 0.6) !important;
  }

  .tshirt-title {
    font-size: clamp(1.6rem, 4.5vw, 2.4rem);
    color: var(--royal-gold);
    font-weight: 900;
    margin-bottom: 1.8rem;
    text-shadow: 0 0 14px rgba(212, 175, 55, 0.45);
    line-height: 1.3;
  }

  .tshirt-poster-img {
    width: 100%;
    max-width: 480px;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 14px;
    border: 2px solid var(--royal-gold);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7), 0 0 22px rgba(212, 175, 55, 0.25);
  }
</style>

<section class="main-content-gradient">
  <div class="container" style="max-width: 800px; text-align: center;">
    
    <div class="tshirt-showcase-card">
      <h1 class="tshirt-title">
        <span class="lang-mr">आगमन सोहळा टी-शर्ट २०२६</span>
        <span class="lang-en">Aagman Sohala T-Shirt 2026</span>
      </h1>

      <div style="display: inline-block; width: 100%; margin: 0 auto;">
        <picture>
          <source srcset="/images/tshirt_info.webp?v=20261011" type="image/webp">
          <img src="/images/tshirt_info.png?v=20261011" alt="Dagdi Chawl Chi Aai Mauli Official T-Shirt" width="600" height="780" loading="eager" class="tshirt-poster-img">
        </picture>
      </div>
    </div>

  </div>
</section>

<%- include('partials/footer') %>
