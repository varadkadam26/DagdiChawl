<%- include('partials/header') %>

<style>
  body {
    background: radial-gradient(circle at center, #422315 0%, #050403 100%) !important;
    min-height: 100vh;
  }
  .main-content-gradient, .page-hero-banner {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  
  /* Make cards transparent to blend with dark gradient */
  .card-temple {
    background: transparent !important;
    border: 1px solid rgba(212, 175, 55, 0.2) !important;
    box-shadow: none !important;
  }
</style>

<section class="page-hero-banner">
  <div class="container" style="text-align: center;">
    <span class="section-badge">
      <span class="lang-mr">अधिकृत वस्त्रालंकार २०२६</span>
      <span class="lang-en">OFFICIAL T-SHIRT 2026</span>
    </span>
    <h1 style="color: var(--royal-gold); font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 900; margin-bottom: 0.5rem;">
      <span class="lang-mr">दगडी चाळ ची आई माऊली - टी-शर्ट बुकिंग</span>
      <span class="lang-en">Dagdi Chawl Chi Aai Mauli - T-Shirt Booking</span>
    </h1>
    <p style="color: #F4EDE0; font-size: 1.1rem;">
      <span class="lang-mr">भायखळा दगडी चाळ सार्वजनिक नवरात्रौत्सव मंडळ (स्थापना १९७३)</span>
      <span class="lang-en">Byculla Dagdi Chawl Sarvajanik Navratrotsav Mandal (Est. 1973)</span>
    </p>
  </div>
</section>

<section class="main-content-gradient" style="padding: 4rem 0;">
  <div class="container" style="max-width: 950px;">
    
    <!-- Important Notice Banner -->
    <div class="card-temple" style="padding: 1.2rem 1.5rem; margin-bottom: 2.5rem; text-align: center; border-color: var(--royal-gold);">
      <p style="color: #F5D98E; font-weight: 800; font-size: 1rem; margin: 0; line-height: 1.6;">
        ⚠️ <span class="lang-mr">टीप: कोणत्याही व्यक्तीने पावती शिवाय टी-शर्ट बुकिंग करू नये तसेच पावती शिवाय टी-शर्ट दिली जाणार नाही.</span>
        <span class="lang-en">Note: T-shirt will not be issued without an official receipt token.</span>
      </p>
    </div>

    <div class="grid-2" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: flex-start; margin-bottom: 3rem;">
      
      <!-- T-Shirt Poster & Pricing Showcase -->
      <div>
        <div class="card-temple" style="padding: 2rem; text-align: center; margin-bottom: 2rem;">
          <div style="margin-bottom: 1.5rem; display: inline-block; width: 100%;">
            <picture>
              <source srcset="/images/tshirt_info.webp?v=20261011" type="image/webp">
              <img src="/images/tshirt_info.png?v=20261011" alt="Dagdi Chawl Chi Aai Mauli Official T-Shirt" width="600" height="780" loading="eager" style="width: 100%; max-width: 420px; height: auto; display: block; margin: 0 auto; border-radius: 12px; border: 2px solid var(--royal-gold); box-shadow: var(--shadow-md);">
            </picture>
          </div>

          <h3 style="font-size: 1.5rem; color: var(--royal-gold); font-weight: 800; margin-bottom: 0.5rem;">
            आगमन सोहळा टी-शर्ट २०२६
          </h3>
          <p style="color: #F4EDE0; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
            उच्च दर्जाचा कॉटन पोलो टी-शर्ट, अधिकृत राजमुद्रा व आई माऊलींच्या प्रतिमेसह.
          </p>

          <!-- Pricing Tiers Table -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-top: 1px dashed var(--border-gold); padding-top: 1.2rem;">
            <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-gold); border-radius: 10px; padding: 1rem;">
              <span style="font-size: 0.85rem; font-weight: 700; color: #E2E8F0; display: block;">साईझ २० ते ३०</span>
              <h4 style="font-size: 1.6rem; color: var(--royal-gold); font-weight: 900; margin: 4px 0 0;">₹३३०/-</h4>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-gold); border-radius: 10px; padding: 1rem;">
              <span style="font-size: 0.85rem; font-weight: 700; color: #E2E8F0; display: block;">साईझ ३२ ते ५०</span>
              <h4 style="font-size: 1.6rem; color: var(--royal-gold); font-weight: 900; margin: 4px 0 0;">₹३५०/-</h4>
            </div>
          </div>
        </div>

        <!-- Committee Contact Persons Card -->
        <div class="card-temple" style="padding: 1.8rem;">
          <h4 style="font-size: 1.2rem; color: var(--royal-gold); font-weight: 800; margin-bottom: 1rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.5rem; text-align: center;">
            📞 संपर्क व्यक्ती / टी-शर्ट हेल्पलाइन
          </h4>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.8rem; font-size: 0.9rem;">
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">निहार रांजनकर:</span> <a href="tel:7021748279" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">7021748279</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">प्रसाद जाधव:</span> <a href="tel:9082958856" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">9082958856</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">सुदेश गांगण:</span> <a href="tel:9326112657" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">9326112657</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">सार्थक पिसाळ:</span> <a href="tel:9702804747" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">9702804747</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">विघ्नेश टेंबे:</span> <a href="tel:9867363884" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">9867363884</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">दिवेश रांजनकर:</span> <a href="tel:7304860930" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">7304860930</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">शशांक रांजनकर:</span> <a href="tel:7045527910" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">7045527910</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 8px 12px; border-radius: 8px; border: 1px solid rgba(212, 175, 55, 0.3);">
              <span style="color: #FFF;">ऋषिकेश हिंगे:</span> <a href="tel:8828464701" style="color: var(--royal-gold); font-weight: 700; text-decoration: none;">8828464701</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Booking Form -->
      <div class="card-temple" style="padding: 2.5rem;">
        <h3 style="font-size: 1.6rem; color: var(--royal-gold); font-weight: 800; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border-gold); padding-bottom: 0.5rem;">
          📝 टी-शर्ट ऑनलाईन बुकिंग फॉर्म
        </h3>

        <form id="tshirtForm">
          <!-- Buyer Full Name -->
          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
              तुमचे संपूर्ण नाव *
            </label>
            <input type="text" id="buyerName" required placeholder="नाव टाका" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <!-- Mobile & Email Grid -->
          <div class="form-grid-2" style="margin-bottom: 1.2rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
                मोबाईल नंबर (WhatsApp) *
              </label>
              <input type="tel" id="buyerPhone" required placeholder="१० अंकी मोबाईल नंबर" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
            </div>
            <div>
              <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
                ईमेल आयडी (Optional)
              </label>
              <input type="email" id="buyerEmail" placeholder="ईमेल आयडी टाका" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
            </div>
          </div>

          <!-- Size & Quantity Selection -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.2rem;">
            <div>
              <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
                टी-शर्ट साईझ (Size) *
              </label>
              <select id="tshirtSize" required style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; background: #1A0D00; color: #FFF;">
                <option value="Size 20" data-price="330">Size 20 (₹330/-)</option>
                <option value="Size 22" data-price="330">Size 22 (₹330/-)</option>
                <option value="Size 24" data-price="330">Size 24 (₹330/-)</option>
                <option value="Size 26" data-price="330">Size 26 (₹330/-)</option>
                <option value="Size 28" data-price="330">Size 28 (₹330/-)</option>
                <option value="Size 30" data-price="330">Size 30 (₹330/-)</option>
                <option value="Size 32" data-price="350">Size 32 (₹350/-)</option>
                <option value="Size 34" data-price="350">Size 34 (₹350/-)</option>
                <option value="S (Size 36)" data-price="350" selected>S (Size 36) - ₹350/-</option>
                <option value="M (Size 38)" data-price="350">M (Size 38) - ₹350/-</option>
                <option value="L (Size 40)" data-price="350">L (Size 40) - ₹350/-</option>
                <option value="XL (Size 42)" data-price="350">XL (Size 42) - ₹350/-</option>
                <option value="XXL (Size 44)" data-price="350">XXL (Size 44) - ₹350/-</option>
                <option value="3XL (Size 46)" data-price="350">3XL (Size 46) - ₹350/-</option>
                <option value="4XL (Size 48)" data-price="350">4XL (Size 48) - ₹350/-</option>
                <option value="5XL (Size 50)" data-price="350">5XL (Size 50) - ₹350/-</option>
              </select>
            </div>

            <div>
              <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
                संख्या (Quantity) *
              </label>
              <input type="number" id="tshirtQty" min="1" max="50" value="1" required style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; background: #1A0D00; color: #FFF; font-weight: bold;">
            </div>
          </div>

          <!-- Calculated Total Amount Card -->
          <div style="background: rgba(255, 255, 255, 0.05); border: 1px dashed var(--border-gold); border-radius: 8px; padding: 1rem; margin-bottom: 1.2rem; text-align: center;">
            <span style="font-size: 0.85rem; color: #E2E8F0; font-weight: bold; text-transform: uppercase;">एकूण देय रक्कम (Total Amount)</span>
            <h4 id="tshirtTotalDisplay" style="font-size: 2rem; color: var(--royal-gold); font-weight: 900; margin: 4px 0 0;">₹ ३५०/-</h4>
          </div>

          <!-- Pickup / Delivery Option -->
          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
              टी-शर्ट स्वीकृती पर्याय (Delivery Preference)
            </label>
            <select id="tshirtAddress" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; background: #1A0D00; color: #FFF;">
              <option value="Mandap Counter Pickup (Dagdi Chawl)">मंडप काउंटर पिकअप (दगडी चाळ)</option>
              <option value="Home Courier Delivery">होम कूरियर डिलिव्हरी (All India)</option>
            </select>
          </div>

          <!-- Payment UTR Number -->
          <div style="margin-bottom: 1.8rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: #FFFFFF;">
              पेमेंट UTR / व्यवहार क्रमांक (Payment UTR No) *
            </label>
            <input type="text" id="paymentUtrNo" required placeholder="१२ अंकी UTR नंबर प्रविष्ट करा" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem; font-family: monospace; font-weight: bold;">
            <small style="color: #D1D5DB; font-size: 0.8rem; display: block; margin-top: 4px;">
              <i class="fa-solid fa-circle-info"></i> खालील QR कोड किंवा UPI ID वर पेमेंट केल्यानंतर मिळणारा १२ अंकी UTR प्रविष्ट करा.
            </small>
          </div>

          <button type="submit" id="btnTshirtSubmit" class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1.05rem; font-weight: 800;">
            <span>टी-शर्ट बुकिंग करा व पावती मिळवा</span> <i class="fa-solid fa-arrow-right" style="margin-left: 6px;"></i>
          </button>
        </form>
      </div>

    </div>

    <!-- UPI Scan & Pay Card Section (Matching Donate Workflow) -->
    <div class="card-temple" style="padding: 2.5rem; text-align: center; background: rgba(10, 10, 10, 0.6); border: 2px solid var(--royal-gold); box-shadow: var(--shadow-md); margin-bottom: 2.5rem;">
      <div style="background: rgba(212, 175, 55, 0.1); border-radius: var(--radius-md); padding: 1rem 1.5rem; margin-bottom: 1.5rem; display: inline-block;">
        <span style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: var(--primary-saffron); letter-spacing: 1px;">
          Bank of Maharashtra
        </span>
        <h3 style="font-size: 1.4rem; color: var(--royal-gold); margin: 0.2rem 0 0;">
          SCAN & PAY VIA UPI FOR T-SHIRT
        </h3>
      </div>

      <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1.5rem;">
        <div style="padding: 12px; background: rgba(10, 10, 10, 0.6); border: 2px solid var(--royal-gold); border-radius: 12px; box-shadow: var(--shadow-sm); display: inline-block;">
          <img src="/images/qr_code.png" alt="Bank of Maharashtra UPI QR Code" style="width: 250px; height: auto; display: block;">
        </div>
        
        <div style="background: rgba(255, 255, 255, 0.05); border: 1.5px solid var(--border-gold); padding: 0.8rem 1.4rem; border-radius: 50px; display: inline-flex; align-items: center; gap: 10px; max-width: 100%;">
          <i class="fa-solid fa-qrcode" style="color: var(--primary-saffron); font-size: 1.2rem;"></i>
          <span style="font-family: monospace; font-size: 1.05rem; font-weight: 800; color: var(--royal-gold);" id="textUpiId">
            bdc@mahb
          </span>
          <button type="button" onclick="navigator.clipboard.writeText('bdc@mahb'); alert('UPI ID Copied: bdc@mahb');" style="background: var(--temple-maroon); color: #FFF; border: none; padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 700; cursor: pointer; white-space: nowrap;">
            <i class="fa-regular fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">
        <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> Google Pay</span>
        <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> PhonePe</span>
        <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> Paytm</span>
        <span><i class="fa-solid fa-check-circle" style="color: #16A34A;"></i> BHIM UPI</span>
      </div>
    </div>

    <!-- Bank Details Section (Matching Donate Workflow) -->
    <div class="card-temple" style="padding: 3rem;">
      <h2 style="font-size: 1.8rem; color: var(--royal-gold); margin-bottom: 1.5rem; text-align: center;">
        बँक खाते तपशील / Bank Account Details
      </h2>
      
      <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-gold); padding: 2rem; border-radius: var(--radius-sm); font-size: 1.1rem; line-height: 1.8; color: #FFFFFF;">
        <div style="display: flex; flex-direction: column; gap: 0.8rem;">
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
            <strong style="color: var(--royal-gold);">बँकेचे नाव:</strong>
            <span>Bank of Maharashtra</span>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
            <strong style="color: var(--royal-gold);">खात्याचे नाव:</strong>
            <span>BYCULLA DAGDI CHAWL SARVAJANIK NAVRATROTSAV MANDAL</span>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
            <strong style="color: var(--royal-gold);">UPI ID:</strong>
            <span style="font-family: monospace; font-size: 1.15rem; font-weight: bold; color: var(--primary-saffron);">bdc@mahb</span>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
            <strong style="color: var(--royal-gold);">खाते क्रमांक:</strong>
            <span style="font-family: monospace; font-size: 1.2rem; font-weight: bold;">20023347685</span>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; border-bottom: 1px dashed var(--border-gold); padding-bottom: 0.5rem;">
            <strong style="color: var(--royal-gold);">आयएफएससी कोड:</strong>
            <span style="font-family: monospace; font-size: 1.2rem; font-weight: bold;">MAHB0000294</span>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between;">
            <strong style="color: var(--royal-gold);">शाखा:</strong>
            <span>MUMBAI JACOB CIRCLE</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Confirmation Success Modal (Matching Donation Workflow) -->
<div id="tshirtSuccessModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 99999; align-items: center; justify-content: center; padding: 1rem;">
  <div style="background: rgba(10, 10, 10, 0.95); border: 3px solid var(--royal-gold); border-radius: var(--radius-lg); max-width: 500px; width: 100%; padding: 2.5rem; text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
    <div style="width: 70px; height: 70px; background: #D1FAE5; color: #059669; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 1.2rem;">
      <i class="fa-solid fa-circle-check"></i>
    </div>
    <h3 style="color: var(--royal-gold); font-size: 1.5rem; margin-bottom: 0.6rem;">तुमची टी-शर्ट बुकिंग नोंदणी यशस्वी झाली आहे!</h3>
    <p style="color: #E5E7EB; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">
      मंडळाच्या बँक पडताळणीनंतर (Admin Approval) तुमची अधिकृत <strong>टी-शर्ट बुकिंग पावती</strong> मंजूर केली जाईल.
    </p>
    <div style="background: rgba(255, 255, 255, 0.05); border: 1px dashed var(--border-gold); padding: 1rem; border-radius: 8px; margin-bottom: 1.8rem; font-size: 0.9rem; text-align: left;">
      <div><strong>पावती क्रमांक:</strong> <span id="modalTshirtReceiptNo" style="font-family: monospace; font-weight: bold; color: var(--royal-gold);"></span></div>
      <div><strong>पडताळणी स्थिती:</strong> <span style="color: #D97706; font-weight: bold;">पडताळणी प्रलंबित (Pending Admin Approval)</span></div>
    </div>
    <button type="button" class="btn btn-primary" onclick="window.location.reload();" style="width: 100%; padding: 0.85rem; font-weight: bold;">
      ठीक आहे (OK)
    </button>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tshirtSizeSelect = document.getElementById('tshirtSize');
    const tshirtQtyInput = document.getElementById('tshirtQty');
    const tshirtTotalDisplay = document.getElementById('tshirtTotalDisplay');

    function calculateTotal() {
      const selectedOption = tshirtSizeSelect.options[tshirtSizeSelect.selectedIndex];
      const unitPrice = parseInt(selectedOption.getAttribute('data-price') || 350, 10);
      const qty = parseInt(tshirtQtyInput.value, 10) || 1;
      const total = qty * unitPrice;
      tshirtTotalDisplay.textContent = `₹ ${total.toLocaleString('en-IN')}/-`;
      return total;
    }

    if (tshirtSizeSelect && tshirtQtyInput) {
      tshirtSizeSelect.addEventListener('change', calculateTotal);
      tshirtQtyInput.addEventListener('input', calculateTotal);
    }

    const tshirtForm = document.getElementById('tshirtForm');
    if (!tshirtForm) return;

    tshirtForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btnTshirtSubmit');
      const btnTextSpan = btn.querySelector('span');
      btn.disabled = true;
      if (btnTextSpan) btnTextSpan.textContent = 'बुकिंग होत आहे... (Submitting)';

      const buyerName = document.getElementById('buyerName').value;
      const buyerPhone = document.getElementById('buyerPhone').value;
      const buyerEmail = document.getElementById('buyerEmail').value;
      const tshirtSize = document.getElementById('tshirtSize').value;
      const qty = parseInt(document.getElementById('tshirtQty').value, 10) || 1;
      const tshirtAddress = document.getElementById('tshirtAddress').value;
      const paymentUtrNo = document.getElementById('paymentUtrNo').value.trim();
      const totalAmount = calculateTotal();

      try {
        const res = await fetch('/tshirt/confirm', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            buyer_name: buyerName,
            phone: buyerPhone,
            email: buyerEmail,
            size: tshirtSize,
            quantity: qty,
            total_amount: totalAmount,
            address: tshirtAddress,
            payment_utr: paymentUtrNo,
            payment_id: paymentUtrNo
          })
        });

        const data = await res.json();
        if (data.success) {
          document.getElementById('modalTshirtReceiptNo').textContent = data.receipt_no;
          const modal = document.getElementById('tshirtSuccessModal');
          if (modal) modal.style.display = 'flex';
        } else {
          alert(data.message || 'टी-शर्ट बुकिंग करताना त्रुटी आली.');
          btn.disabled = false;
          if (btnTextSpan) btnTextSpan.textContent = 'टी-शर्ट बुकिंग करा व पावती मिळवा';
        }
      } catch (err) {
        console.error('Submission error:', err);
        alert('नेटवर्क किंवा सर्वर त्रुटी आली.');
        btn.disabled = false;
        if (btnTextSpan) btnTextSpan.textContent = 'टी-शर्ट बुकिंग करा व पावती मिळवा';
      }
    });
  });
</script>

<%- include('partials/footer') %>
