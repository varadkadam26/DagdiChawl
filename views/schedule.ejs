<%- include('partials/header') %>

<style>
  body {
    background: linear-gradient(135deg, #100A07 0%, #28140C 100%) !important;
    min-height: 100vh;
  }
  .main-content-gradient {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: clamp(125px, 15vw, 150px) 0 3.5rem !important;
  }
  
  .schedule-mandal-title {
    font-family: var(--font-mr-head);
    color: var(--gold-soft);
    font-weight: 900;
    font-size: clamp(1.35rem, 4.2vw, 2.1rem);
    line-height: 1.3;
    margin-bottom: 0.4rem;
    text-shadow: 0 0 14px rgba(212, 175, 55, 0.4), 1px 1px 4px rgba(0,0,0,0.8);
    word-break: break-word;
  }
  .schedule-section-title {
    font-family: var(--font-mr-head);
    color: #FFFFFF;
    font-weight: 800;
    font-size: clamp(1.15rem, 3.5vw, 1.65rem);
    line-height: 1.35;
    margin-top: 0.4rem;
    text-shadow: 0 0 10px rgba(212, 175, 55, 0.6), 1px 1px 3px rgba(0,0,0,0.8);
  }
  .schedule-subheading {
    font-size: clamp(0.95rem, 3.2vw, 1.25rem);
    font-weight: 800;
    line-height: 1.5;
    color: var(--primary-saffron);
    text-shadow: 0 0 8px rgba(203, 161, 53, 0.5);
    margin-bottom: 0.35rem;
  }
  
  /* Responsive clamp fonts to keep elements well fitted */
  .fit-1-line-lg {
    font-size: clamp(1.2rem, 3.8vw, 1.8rem) !important;
  }
  .fit-1-line-md {
    font-size: clamp(1.05rem, 3.2vw, 1.5rem) !important;
  }
  .fit-1-line-sm {
    font-size: clamp(0.9rem, 2.8vw, 1.25rem) !important;
  }
  .fit-1-line-xs {
    font-size: clamp(0.75rem, 2.2vw, 0.95rem) !important;
  }
  
  .card-temple {
    gap: 0.5rem !important;
    padding: 1rem 1.2rem !important;
    justify-content: space-between !important;
    overflow: hidden;
  }
  
  .event-title {
    font-size: clamp(0.95rem, 3.5vw, 1.3rem);
    line-height: 1.4;
    word-break: break-word;
  }
  
  @media (max-width: 768px) {
    .card-temple {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.8rem !important;
    }
    .event-time-badge {
      align-self: flex-start !important;
    }
  }

  .schedule-highlight-card {
    background: transparent !important;
    border: 1px solid rgba(212, 175, 55, 0.45) !important;
    box-shadow: 0 0 16px rgba(212, 175, 55, 0.22), inset 0 0 12px rgba(212, 175, 55, 0.05) !important;
    border-radius: var(--radius-md) !important;
    padding: 1.1rem 1.4rem !important;
    margin-top: 1rem !important;
    text-align: center !important;
    font-weight: 800 !important;
    color: #FFFFFF !important;
    transition: all 0.3s ease;
  }
  .schedule-highlight-card:hover {
    border-color: rgba(212, 175, 55, 0.7) !important;
    box-shadow: 0 0 22px rgba(212, 175, 55, 0.35), inset 0 0 15px rgba(212, 175, 55, 0.08) !important;
  }
</style>

<section class="main-content-gradient">
  <div class="container" style="max-width: 900px;">
    
    <div style="background: transparent; border: none; border-radius: var(--radius-lg); padding: 0.5rem 0.5rem 1.5rem; box-shadow: none; margin-bottom: 1.5rem;">
      <div style="text-align: center; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border-gold); padding-bottom: 1.2rem;">
        <div class="schedule-mandal-title">
          <span class="lang-mr">भायखळा दगडी चाळ सार्वजनिक नवरात्रौत्सव मंडळ</span>
          <span class="lang-en">Byculla Dagdi Chawl Sarvajanik Navratrotsav Mandal</span>
        </div>
        <h1 class="schedule-section-title">
          <span class="lang-mr">अधिकृत कार्यक्रम यादी</span><span class="lang-en">Official Program List</span>
        </h1>
      </div>

      <div style="text-align: center; margin-bottom: 1.2rem;">
        <div class="schedule-subheading lang-mr">कालावधी - शनिवार दि. १० ऑक्टोबर ते बुधवार दि. २१ ऑक्टोबर २०२६</div>
        <div class="schedule-subheading lang-en">Duration - Saturday, 10 Oct to Wednesday, 21 Oct 2026</div>
        <div class="schedule-subheading lang-mr">शनिवार १०/१०/२०२६ रात्री ८.०० वा. देवीचे आगमन</div>
        <div class="schedule-subheading lang-en">Saturday 10/10/2026 at 8:00 PM - Arrival of the Goddess</div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% scheduleData.forEach(evt => { %>
          <div class="card-temple" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.5rem; background: <%= evt.bg || 'var(--bg-dark)' %>; border: 1px solid var(--border-gold); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 1rem; flex-shrink: 0;">
              <div style="background: <%= evt.color === '#D32F2F' ? 'var(--temple-maroon)' : 'rgba(255,255,255,0.2)' %>; color: <%= evt.color === '#D32F2F' ? 'var(--gold-soft)' : '#FFFFFF' %>; padding: 0.5rem 1rem; border-radius: var(--radius-sm); font-weight: 800; text-align: center; border: 1px solid rgba(255,255,255,0.3);" class="fit-1-line-xs">
                <span class="lang-mr"><%= evt.dateMr %></span>
                <span class="lang-en"><%= evt.dateEn %></span>
              </div>
            </div>

            <div style="flex: 1; overflow: hidden;">
              <h3 style="color: <%= evt.color || 'var(--temple-maroon)' %>; margin: 0; font-weight: 800;" data-mr="<%= evt.titleMr %>" data-en="<%= evt.titleEn %>" class="event-title">
                <span class="lang-mr"><%= evt.titleMr %></span>
                <span class="lang-en"><%= evt.titleEn %></span>
              </h3>
            </div>

            <% if (evt.timeMr) { %>
              <div class="event-time-badge" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: <%= evt.color || 'var(--primary-saffron)' %>; font-weight: 700; padding: 0.4rem 0.9rem; border-radius: 20px; flex-shrink: 0; font-size: clamp(0.75rem, 2.5vw, 0.95rem);">
                <i class="fa-regular fa-clock"></i> <span class="lang-mr"><%= evt.timeMr %></span><span class="lang-en"><%= evt.timeEn %></span>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>

      <div class="schedule-highlight-card">
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); margin-bottom: 0.5rem; line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-mr">मंगळवार २०/१०/२०२६ रात्री आरती नंतर - विद्यार्थी गुणगौरव सोहळा नंतर रासगरबा</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); margin-bottom: 0.5rem; line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-en">Tuesday 20/10/2026 After Aarti - Student Felicitation & Rasgarba</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-mr">बुधवार २१/१०/२०२६ सायंकाळी ५.०० नंतर - देवी विसर्जन सोहळा</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-en">Wednesday 21/10/2026 After 5:00 PM - Devi Visarjan Ceremony</div>
      </div>

      <div style="background: transparent; padding: 1rem 0; margin-top: 1.5rem; text-align: center;">
        <h3 class="schedule-section-title" style="margin-bottom: 0.8rem; color: var(--primary-saffron); text-shadow: 0 0 10px rgba(203, 161, 53, 0.5);">
          <span class="lang-mr">महत्त्वाची सूचना</span>
          <span class="lang-en">Important Instructions</span>
        </h3>
        
        <p style="font-weight: 800; margin-bottom: 0.5rem; color: var(--gold-soft); font-size: clamp(1rem, 3vw, 1.25rem);" class="lang-mr">रोज सकाळी ९:०० वा. व रात्री ८:०० वा. देवीची आरती</p>
        <p style="color: #ffffff; opacity: 0.95; font-size: clamp(0.85rem, 2.5vw, 1.05rem);" class="lang-mr">वि. सूचना : कार्यक्रमात फेरफार करण्याचा अधिकार उत्सव समितीवर असेल.</p>
        
        <p style="font-weight: 800; margin-bottom: 0.5rem; color: var(--gold-soft); font-size: clamp(1rem, 3vw, 1.25rem);" class="lang-en">Daily Morning 9:00 AM & Night 8:00 PM Devi's Aarti</p>
        <p style="color: #ffffff; opacity: 0.95; font-size: clamp(0.85rem, 2.5vw, 1.05rem);" class="lang-en">Note: The festival committee reserves the right to make changes to the schedule.</p>
      </div>
    </div>

    <!-- Devi's Jagran Section -->
    <div style="background: transparent; border: none; border-radius: var(--radius-lg); padding: 1rem 0.5rem 1.5rem; box-shadow: none; margin-bottom: 1.5rem;">
      <div style="text-align: center; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border-gold); padding-bottom: 1.2rem;">
        <div class="schedule-mandal-title">
          <span class="lang-mr">भायखळा दगडी चाळ सार्वजनिक नवरात्रौत्सव मंडळ</span>
          <span class="lang-en">Byculla Dagdi Chawl Sarvajanik Navratrotsav Mandal</span>
        </div>
        <div class="schedule-section-title">
          <span class="lang-mr">देवीचे जागरण - २०२६</span><span class="lang-en">Devi's Jagran - 2026</span>
        </div>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% jagranData.forEach(evt => { %>
          <div class="card-temple" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.2rem 1.5rem; background: <%= evt.bg || 'var(--bg-dark)' %>; border: 1px solid var(--border-gold); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: center; gap: 1rem; flex-shrink: 0;">
              <div style="background: <%= evt.color === '#D32F2F' ? 'var(--temple-maroon)' : 'rgba(255,255,255,0.2)' %>; color: <%= evt.color === '#D32F2F' ? 'var(--gold-soft)' : '#FFFFFF' %>; padding: 0.5rem 1rem; border-radius: var(--radius-sm); font-weight: 800; text-align: center; border: 1px solid rgba(255,255,255,0.3);" class="fit-1-line-xs">
                <span class="lang-mr"><%= evt.dateMr %></span>
                <span class="lang-en"><%= evt.dateEn %></span>
              </div>
            </div>

            <div style="flex: 1; overflow: hidden;">
              <h3 style="color: <%= evt.color || 'var(--temple-maroon)' %>; margin: 0; font-weight: 800;" data-mr="<%= evt.titleMr %>" data-en="<%= evt.titleEn %>" class="event-title">
                <span class="lang-mr"><%= evt.titleMr %></span>
                <span class="lang-en"><%= evt.titleEn %></span>
              </h3>
            </div>
          </div>
        <% }); %>
      </div>

      <div class="schedule-highlight-card">
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); margin-bottom: 0.5rem; line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-mr">मंगळवार दिनांक : २०/१०/२०२६ रोजी दसरा स्नेहसंमेलन</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); margin-bottom: 0.5rem; line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-en">Tuesday Date: 20/10/2026 Dussehra Snehsammelan</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-mr">बुधवार दि. २१/१०/२०२६ रोजी सायंकाळी ५.०० च्या नंतर देवीचे विसर्जन</div>
        <div style="font-size: clamp(0.85rem, 3.2vw, 1.15rem); line-height: 1.45; color: #FFFFFF; text-shadow: 0 1px 3px rgba(0,0,0,0.8), 0 0 8px rgba(212, 175, 55, 0.3);" class="lang-en">Wednesday Date: 21/10/2026 After 5:00 PM Devi Visarjan</div>
      </div>

  </div>
</section>

<%- include('partials/footer') %>
