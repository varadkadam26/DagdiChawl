<%- include('partials/header') %>

<style>
  body {
    background: linear-gradient(125deg, #050403 0%, #100A07 38%, #28140C 72%, #422315 100%) !important;
    min-height: 100vh;
  }
  .main-content-gradient, .page-hero-banner {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  
  /* Make cards transparent to blend with dark gradient */
  .card-temple {
    background: transparent !important;
    border: 1px solid rgba(212, 175, 55, 0.2) !important;
    box-shadow: none !important;
  }
  
  /* Adjust specific text colors for dark mode */
  .page-hero-banner h1, .page-hero-banner p {
    color: var(--gold-soft) !important;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
  }
  .page-hero-banner p {
    color: #f1f1f1 !important;
  }
  
  /* Exceptional colors */
  .section-badge {
    color: var(--gold-soft) !important;
    border-color: var(--gold-soft) !important;
  }
  .fa-solid, .fa-brands, .fa-regular {
    color: var(--primary-saffron) !important;
  }
  
  /* Form dark mode styling */
  input, textarea {
    background: rgba(255,255,255,0.05) !important;
    color: #ffffff !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
  }
  input::placeholder, textarea::placeholder {
    color: rgba(255,255,255,0.4) !important;
  }
</style>

<section class="page-hero-banner">
  <div class="container">
    <span class="section-badge">
      <span class="lang-mr">संपर्क व पत्ता</span>
      <span class="lang-en">Contact & Address</span>
    </span>
    <h1>
      <span class="lang-mr">आमचे संपर्क</span>
      <span class="lang-en">Contact Us</span>
    </h1>
    <p>
      <span class="lang-mr">श्री बाल गोपाल गणेशोत्सव मंडळ कार्यकारिणीशी संपर्क साधा.</span>
      <span class="lang-en">Get in touch with the Shree Bal Gopal Ganeshotsav Mandal committee.</span>
    </p>
  </div>
</section>

<section class="main-content-gradient" style="padding: 5rem 0;">
  <div class="container">
    
    <div class="grid-2" style="margin-bottom: 4rem;">
      <!-- Contact Info Box -->
      <div class="card-temple" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem; border-left: 4px solid var(--royal-gold); padding-left: 1rem;">
          <span class="lang-mr">मंडळ मुख्य कार्यालय</span>
          <span class="lang-en">Mandal Head Office</span>
        </h2>

        <div style="margin-bottom: 1.8rem;">
          <h4 style="color: var(--primary-saffron); font-size: 1.05rem; margin-bottom: 0.4rem;">
            <i class="fa-solid fa-building-columns" style="margin-right: 8px;"></i> 
            <span class="lang-mr">मण्डप व मुख्य कार्यालय पत्ता</span>
            <span class="lang-en">Mandap & Head Office Address</span>
          </h4>
          <p style="color: rgba(255, 255, 255, 0.85); font-size: 0.98rem; line-height: 1.7;">
            <span class="lang-mr">७१४, दगडी चाळ, बापूराव जगताप मार्ग, भायखळा (पश्चिम), मुंबई - ४०००११.</span>
            <span class="lang-en">714, Dagdi Chawl, Bapurao Jagtap Marg, Byculla (W), Mumbai - 400011.</span>
          </p>
        </div>

        <div style="margin-bottom: 1.8rem;">
          <h4 style="color: var(--primary-saffron); font-size: 1.05rem; margin-bottom: 0.4rem;">
            <i class="fa-solid fa-phone" style="margin-right: 8px;"></i> 
            <span class="lang-mr">आपत्कालीन व मदत केंद्र</span>
            <span class="lang-en">Emergency & Help Desk</span>
          </h4>
          <p style="color: rgba(255, 255, 255, 0.85); font-size: 0.98rem; line-height: 1.7;">
            <span class="lang-mr">फोन: +९१ ९५९४५ १२९९९<br>व्हॉट्सॲप हेल्पलाईन: +९१ ९५९४५ १२९९९</span>
            <span class="lang-en">Phone: +91 95945 12999<br>WhatsApp Helpline: +91 95945 12999</span>
          </p>
        </div>

        <div>
          <h4 style="color: var(--primary-saffron); font-size: 1.05rem; margin-bottom: 0.4rem;">
            <i class="fa-solid fa-envelope" style="margin-right: 8px;"></i> 
            <span class="lang-mr">अधिकृत ईमेल पत्ता</span>
            <span class="lang-en">Official Email Address</span>
          </h4>
          <p style="color: rgba(255, 255, 255, 0.85); font-size: 0.98rem; line-height: 1.7;">
            byculladagadichawlnavratri1973@gmail.com
          </p>
        </div>
      </div>

      <!-- Contact Inquiry Form -->
      <div class="card-temple" style="padding: 2.5rem;">
        <h2 style="font-size: 1.8rem; color: var(--temple-maroon); margin-bottom: 1.5rem;">
          <span class="lang-mr">संदेश पाठवा</span>
          <span class="lang-en">Send a Message</span>
        </h2>

        <form id="contactForm">
          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--gold-soft);">
              <span class="lang-mr">तुमचे नाव *</span>
              <span class="lang-en">Your Name *</span>
            </label>
            <input type="text" id="cName" required placeholder="संपूर्ण नाव टाका / Enter Full Name" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--gold-soft);">
              <span class="lang-mr">ईमेल पत्ता *</span>
              <span class="lang-en">Email Address *</span>
            </label>
            <input type="email" id="cEmail" required placeholder="ईमेल पत्ता टाका | Enter Email Address" style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;">
          </div>

          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem; color: var(--gold-soft);">
              <span class="lang-mr">तुमचा संदेश / प्रश्न *</span>
              <span class="lang-en">Your Message / Query *</span>
            </label>
            <textarea id="cMessage" rows="4" required placeholder="येथे संदेश लिहा... / Write your message here..." style="width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-gold); font-size: 0.95rem;"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; font-size: 1.05rem;">
            <span class="lang-mr">मंडळाला संदेश पाठवा</span>
            <span class="lang-en">Send Message to Mandal</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Embedded Google Maps at Bottom -->
    <div style="background: transparent; border-radius: var(--radius-lg); border: 1px solid rgba(212, 175, 55, 0.2); padding: 2rem; box-shadow: none;">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
        <h3 style="font-size: 1.6rem; color: var(--temple-maroon); margin: 0;">
          <span class="lang-mr">गूगल मॅप्स - मण्डप स्थान (Malabar Hill Cha Raja)</span>
          <span class="lang-en">Google Maps - Mandap Location (Dagdi Chawl)</span>
        </h3>
        <a href="https://www.google.com/maps/search/Dagdi+Chawl,+Bapurao+Jagtap+Marg,+Byculla+West,+Mumbai+400011" target="_blank" rel="noopener noreferrer" class="btn btn-outline" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
          <i class="fa-solid fa-map-location-dot" style="margin-right: 6px; color: var(--primary-saffron);"></i>
          <span class="lang-mr">गूगल मॅप्सवर उघडा</span>
          <span class="lang-en">Open in Google Maps</span>
        </a>
      </div>

      <div style="width: 100%; height: 400px; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-gold); position: relative;">
        <iframe 
          src="https://www.google.com/maps?q=Dagdi+Chawl,+Bapurao+Jagtap+Marg,+Byculla+West,+Mumbai-400011&output=embed" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </div>

  </div>
</section>

<script>
  document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>संदेश पाठवत आहे... / Sending...</span>';

    const name = document.getElementById('cName').value.trim();
    const email = document.getElementById('cEmail').value.trim();
    const message = document.getElementById('cMessage').value.trim();

    if (!name || !email || !message) {
      alert('कृपया वैध ईमेल पत्ता व सर्व माहिती भरा. / Please enter a valid email and fill all required fields.');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      return;
    }

    try {
      const res = await fetch('/contact/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, contact: email, message })
      });
      const data = await res.json();

      if (data.success) {
        alert(data.message || 'तुमचा संदेश यशस्वीरित्या पाठवला गेला आहे!');
        document.getElementById('contactForm').reset();
      } else {
        alert(data.message || 'संदेश पाठवताना त्रुटी आली.');
      }
    } catch (err) {
      console.error('Contact form error:', err);
      alert('सर्व्हरशी कनेक्ट करता आले नाही. कृपया पुन्हा प्रयत्न करा.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  });
</script>

<%- include('partials/footer') %>
