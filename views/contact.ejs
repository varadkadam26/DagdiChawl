<%- include('partials/header') %>

<style>
  body {
    background: linear-gradient(125deg, #050403 0%, #100A07 38%, #28140C 72%, #422315 100%) !important;
    min-height: 100vh;
  }
  .main-content-gradient, .page-hero-banner {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  
  /* Make cards transparent to blend with dark gradient */
  .card-temple {
    background: transparent !important;
    border: 1px solid rgba(212, 175, 55, 0.2) !important;
    box-shadow: none !important;
  }
  
  /* Adjust specific text colors for dark mode */
  .page-hero-banner h1, .page-hero-banner p {
    color: var(--gold-soft) !important;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
  }
  .page-hero-banner p {
    color: #f1f1f1 !important;
  }
  
  /* Exceptional colors */
  .section-badge {
    color: var(--gold-soft) !important;
    border-color: var(--gold-soft) !important;
  }
  .fa-solid, .fa-brands, .fa-regular {
    color: var(--primary-saffron); text-shadow: 0 0 8px rgba(203, 161, 53, 0.4); !important;
  }
  
  /* Form dark mode styling */
  input, textarea {
    background: rgba(255,255,255,0.05) !important;
    color: #ffffff !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
  }
  input::placeholder, textarea::placeholder {
    color: rgba(255,255,255,0.4) !important;
  }
  /* 3 Cards Titles with complimenting gold color */
  .card-temple h2, 
  .card-temple h3,
  .main-content-gradient h2,
  .main-content-gradient h3 {
    color: #F5D98E !important;
    text-shadow: 0 0 12px rgba(245, 217, 142, 0.35) !important;
  }

  .contact-section {
    padding: clamp(180px, 16vw, 225px) 0 4.5rem !important;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: clamp(160px, 22vw, 195px) 0 3.5rem !important;
    }
  }
</style>

