<script>
  function updateContactPlaceholders() {
    const isMr = document.body.getAttribute('data-lang') === 'mr' || document.documentElement.lang === 'mr';
    const inputs = document.querySelectorAll('[data-ph-mr]');
    inputs.forEach(el => {
      el.placeholder = isMr ? el.getAttribute('data-ph-mr') : el.getAttribute('data-ph-en');
    });
  }

  document.addEventListener('DOMContentLoaded', updateContactPlaceholders);
  window.addEventListener('languageChanged', updateContactPlaceholders);
  const langObserver = new MutationObserver(updateContactPlaceholders);
  langObserver.observe(document.body, { attributes: true, attributeFilter: ['data-lang'] });
  updateContactPlaceholders();

  document.getElementById('contactForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const isMr = document.body.getAttribute('data-lang') === 'mr' || document.documentElement.lang === 'mr';
    const btn = e.target.querySelector('button[type="submit"]');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = isMr ? '<span>संदेश पाठवत आहे...</span>' : '<span>Sending message...</span>';

    const name = document.getElementById('cName').value.trim();
    const email = document.getElementById('cEmail').value.trim();
    const message = document.getElementById('cMessage').value.trim();

    if (!name || !email || !message) {
      alert(isMr ? 'कृपया वैध ईमेल पत्ता व सर्व माहिती भरा.' : 'Please enter a valid email and fill all required fields.');
      btn.disabled = false;
      btn.innerHTML = originalHTML;
      return;
    }

    try {
      const res = await fetch('/contact/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, contact: email, message })
      });
      const data = await res.json();

      if (data.success) {
        alert(isMr ? (data.message || 'तुमचा संदेश यशस्वीरित्या पाठवला गेला आहे!') : 'Your message has been sent successfully!');
        document.getElementById('contactForm').reset();
      } else {
        alert(isMr ? (data.message || 'संदेश पाठवताना त्रुटी आली.') : 'An error occurred while sending your message.');
      }
    } catch (err) {
      console.error('Contact form error:', err);
      alert(isMr ? 'सर्व्हरशी कनेक्ट करता आले नाही. कृपया पुन्हा प्रयत्न करा.' : 'Could not connect to the server. Please try again.');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalHTML;
    }
  });
</script>

