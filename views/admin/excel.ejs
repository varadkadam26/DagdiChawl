<%- include('../partials/header') %>

<style>
  body {
    background: linear-gradient(125deg, #050403 0%, #100A07 38%, #28140C 72%, #422315 100%) !important;
    min-height: 100vh;
  }
  .admin-excel-section {
    background: transparent !important;
    padding: clamp(160px, 15vw, 205px) 0 4rem !important;
  }
  @media (max-width: 768px) {
    .admin-excel-section {
      padding: clamp(140px, 18vw, 165px) 0 3rem !important;
    }
  }

  /* Dark Temple Cards */
  .card-temple {
    background: rgba(22, 14, 10, 0.82) !important;
    border: 1px solid rgba(212, 175, 55, 0.25) !important;
    border-radius: var(--radius-md) !important;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.55), inset 0 0 15px rgba(212, 175, 55, 0.04) !important;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .card-temple:hover {
    border-color: rgba(212, 175, 55, 0.45) !important;
  }

  /* Header & Action Rows */
  .excel-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-bottom: 2.2rem;
  }
  .excel-title {
    font-size: clamp(1.4rem, 4.5vw, 2.2rem) !important;
    color: #F4EDE0 !important;
    text-shadow: 0 0 16px rgba(212, 175, 55, 0.4);
    margin: 0.3rem 0 0.4rem !important;
    font-weight: 800;
  }
  .excel-subtitle {
    color: #D1D5DB !important;
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .excel-back-btn {
    padding: 0.55rem 1.2rem !important;
    font-size: 0.88rem !important;
    border: 1px solid rgba(212, 175, 55, 0.4) !important;
    color: var(--gold-soft) !important;
    font-weight: 700 !important;
    background: rgba(212, 175, 55, 0.1) !important;
    border-radius: var(--radius-sm);
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }
  .excel-back-btn:hover {
    background: var(--royal-gold) !important;
    color: #100A07 !important;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.5);
  }

  @media (max-width: 768px) {
    .excel-header-flex {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      margin-bottom: 1.8rem;
    }
    .excel-back-btn {
      width: 100% !important;
      justify-content: center !important;
      text-align: center;
    }
    .grid-3 {
      grid-template-columns: 1fr !important;
      gap: 1rem !important;
    }
  }

  /* Metric Stat Cards */
  .stat-card-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--primary-saffron);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .stat-card-num {
    font-size: clamp(1.8rem, 4vw, 2.3rem);
    font-weight: 800;
    color: #F4EDE0 !important;
    text-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
    margin: 0.4rem 0;
  }

  /* Form Elements */
  .admin-form-label {
    font-weight: 700;
    display: block;
    margin-bottom: 0.4rem;
    color: #E5E7EB;
    font-size: 0.9rem;
  }
  .admin-input,
  .admin-select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06) !important;
    color: #FFFFFF !important;
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: all 0.3s ease;
  }
  .admin-input:focus,
  .admin-select:focus {
    outline: none;
    border-color: var(--royal-gold) !important;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
    background: rgba(255, 255, 255, 0.1) !important;
  }
  .admin-select option {
    background: #1A0F0A;
    color: #FFFFFF;
  }
  .admin-file-input {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px dashed rgba(212, 175, 55, 0.4) !important;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04) !important;
    color: #F3F4F6 !important;
    font-size: 0.9rem;
    box-sizing: border-box;
  }

  /* Responsive Admin Tables */
  .table-scroll-hint {
    display: none;
    font-size: 0.78rem;
    color: var(--gold-soft);
    background: rgba(212, 175, 55, 0.1);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    margin-bottom: 0.8rem;
    align-items: center;
    gap: 6px;
    border: 1px dashed rgba(212, 175, 55, 0.35);
  }
  @media (max-width: 992px) {
    .table-scroll-hint {
      display: inline-flex;
    }
  }
  .admin-table-container {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 175, 55, 0.22);
    scrollbar-width: thin;
    scrollbar-color: var(--royal-gold) rgba(0, 0, 0, 0.3);
  }
  .admin-table-container::-webkit-scrollbar {
    height: 7px;
  }
  .admin-table-container::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.3);
  }
  .admin-table-container::-webkit-scrollbar-thumb {
    background: var(--royal-gold);
    border-radius: 4px;
  }
  .admin-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.88rem;
  }
  .admin-table thead tr {
    background: linear-gradient(135deg, #3A170A 0%, #1E0C05 100%) !important;
    border-bottom: 2px solid var(--royal-gold);
  }
  .admin-table th {
    padding: 12px 14px;
    color: var(--gold-soft) !important;
    font-weight: 700;
    white-space: nowrap;
    letter-spacing: 0.3px;
  }
  .admin-table td {
    padding: 11px 14px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.12);
    color: #F3F4F6 !important;
    vertical-align: middle;
  }
  .admin-table tr:hover td {
    background: rgba(255, 255, 255, 0.035);
  }

  /* Export Action Buttons */
  .export-btn-group {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  @media (max-width: 768px) {
    .export-btn-group {
      width: 100%;
      flex-direction: column;
    }
    .export-btn-group .btn {
      width: 100% !important;
      justify-content: center !important;
      text-align: center;
    }
  }
</style>

<section class="admin-excel-section">
  <div class="container">
    <div class="excel-header-flex">
      <div>
        <span class="section-badge">मंडळ कार्यकारिणी डेस्क</span>
        <h1 class="excel-title">Excel & Offline Records</h1>
        <p class="excel-subtitle">Upload committee Excel files and keep offline donations and T-shirt bookings alongside online records.</p>
      </div>
      <a href="/admin" class="excel-back-btn">
        <i class="fa-solid fa-arrow-left"></i> ← डॅशबोर्ड (Dashboard)
      </a>
    </div>

    <% if (query.success) { %>
      <div style="background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.45); color: #6EE7B7; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <i class="fa-solid fa-circle-check" style="margin-right: 6px;"></i> <%= query.success %>
      </div>
    <% } %>
    <% if (query.error) { %>
      <div style="background: rgba(239, 68, 68, 0.18); border: 1px solid rgba(239, 68, 68, 0.45); color: #FCA5A5; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem;">
        <i class="fa-solid fa-triangle-exclamation" style="margin-right: 6px;"></i> <%= query.error %>
      </div>
    <% } %>

    <!-- Quick Stats -->
    <div class="grid-3" style="margin-bottom: 2.2rem;">
      <div class="card-temple" style="padding: 1.4rem; text-align: center;">
        <div class="stat-card-title">UPLOADED SHEETS</div>
        <div class="stat-card-num"><%= sheets.length %></div>
      </div>
      <div class="card-temple" style="padding: 1.4rem; text-align: center;">
        <div class="stat-card-title">DONATION SHEETS</div>
        <div class="stat-card-num"><%= sheets.filter(s => s.record_type === 'donation').length %></div>
      </div>
      <div class="card-temple" style="padding: 1.4rem; text-align: center;">
        <div class="stat-card-title">T-SHIRT SHEETS</div>
        <div class="stat-card-num"><%= sheets.filter(s => s.record_type === 'tshirt').length %></div>
      </div>
    </div>

    <!-- Upload Card -->
    <div class="card-temple" style="padding: clamp(1.4rem, 4vw, 2.2rem); margin-bottom: 2.2rem;">
      <h2 style="color: #F4EDE0; margin-top: 0; font-size: clamp(1.2rem, 3.8vw, 1.5rem); text-shadow: 0 0 12px rgba(212, 175, 55, 0.35);">
        <i class="fa-solid fa-file-arrow-up" style="margin-right: 8px; color: var(--primary-saffron);"></i> Upload Committee Excel
      </h2>
      <p style="color: #D1D5DB; font-size: 0.9rem; margin-bottom: 1.4rem;">
        Your committee can use <strong>any column names</strong>. Extra columns are preserved automatically.
      </p>

      <form action="/admin/excel/upload" method="POST" enctype="multipart/form-data">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.2rem;">
          <div>
            <label class="admin-form-label">Record Type *</label>
            <select name="record_type" required class="admin-select">
              <option value="donation">Offline Donations</option>
              <option value="tshirt">Offline T-Shirt Bookings</option>
            </select>
          </div>
          <div>
            <label class="admin-form-label">Sheet Name</label>
            <input type="text" name="sheet_name" placeholder="e.g. July Offline Donations" class="admin-input">
          </div>
          <div>
            <label class="admin-form-label">Excel File (.xlsx, .xls) *</label>
            <input type="file" name="excel_file" accept=".xlsx,.xls" required class="admin-file-input">
          </div>
        </div>

        <div style="margin-top: 1.4rem; padding: 1.1rem; background: rgba(212, 175, 55, 0.08); border: 1px solid rgba(212, 175, 55, 0.25); border-radius: 8px; font-size: 0.88rem; line-height: 1.6; color: #E5E7EB;">
          <strong style="color: var(--gold-soft);"><i class="fa-solid fa-circle-info"></i> Excel format:</strong> Row 1 must contain column headings. Every following row is one record.<br>
          <strong style="color: var(--gold-soft);">Donation amount:</strong> columns such as Amount, Donation Amount, Total, Paid Amount are detected automatically.<br>
          <strong style="color: var(--gold-soft);">T-Shirt quantity:</strong> Quantity, Qty, Count etc. are detected automatically. All other columns remain available in the records.
        </div>

        <button class="btn btn-primary" type="submit" style="margin-top: 1.4rem; padding: 0.75rem 1.6rem; font-weight: 700; box-shadow: 0 0 15px rgba(212, 175, 55, 0.35);">
          <i class="fa-solid fa-upload"></i> Upload Excel
        </button>
      </form>
    </div>

    <!-- Online Records Card -->
    <div class="card-temple" style="padding: clamp(1.4rem, 4vw, 2.2rem); margin-bottom: 2.2rem;">
      <h2 style="color: #F4EDE0; margin-top: 0; font-size: clamp(1.2rem, 3.8vw, 1.5rem); text-shadow: 0 0 12px rgba(212, 175, 55, 0.35);">
        <i class="fa-solid fa-globe" style="margin-right: 8px; color: #38BDF8;"></i> Online Records
      </h2>
      <p style="color: #9CA3AF; font-size: 0.88rem; margin-top: 0.2rem; margin-bottom: 1rem;">These are the records generated directly through the website.</p>
      
      <div class="table-scroll-hint">
        <i class="fa-solid fa-arrows-left-right"></i> आडवे स्क्रोल करा (Scroll horizontally to view all columns)
      </div>

      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Receipt</th>
              <th>Name</th>
              <th>Phone</th>
              <th>Amount</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
            <% onlineDonations.forEach(d => { %>
              <tr>
                <td><span style="color: var(--gold-soft); font-weight: 700;">Donation</span></td>
                <td><%= d.receipt_no %></td>
                <td><%= d.donor_name %></td>
                <td><%= d.phone %></td>
                <td style="font-weight: 800; color: #34D399;">₹ <%= (parseFloat(d.amount)||0).toLocaleString('en-IN') %></td>
                <td>—</td>
              </tr>
            <% }) %>
            <% onlineTshirtOrders.forEach(o => { %>
              <tr>
                <td><span style="color: var(--primary-saffron); font-weight: 700;">T-Shirt</span></td>
                <td><%= o.receipt_no %></td>
                <td><%= o.buyer_name %></td>
                <td><%= o.phone %></td>
                <td style="font-weight: 800; color: #34D399;">₹ <%= (parseFloat(o.total_amount)||0).toLocaleString('en-IN') %></td>
                <td><%= o.quantity %></td>
              </tr>
            <% }) %>
            <% if (!onlineDonations.length && !onlineTshirtOrders.length) { %>
              <tr>
                <td colspan="6" style="padding: 2rem; text-align: center; color: #9CA3AF;">No online records yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Uploaded Committee Sheets Card -->
    <div class="card-temple" style="padding: clamp(1.4rem, 4vw, 2.2rem); margin-bottom: 2.2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem;">
        <div>
          <h2 style="color: #F4EDE0; margin: 0; font-size: clamp(1.2rem, 3.8vw, 1.5rem); text-shadow: 0 0 12px rgba(212, 175, 55, 0.35);">
            <i class="fa-solid fa-folder-open" style="margin-right: 8px; color: var(--gold-soft);"></i> Uploaded Committee Sheets
          </h2>
          <p style="color: #9CA3AF; margin: 0.3rem 0 0; font-size: 0.88rem;">Open a sheet to see every original column and row.</p>
        </div>
        <div class="export-btn-group">
          <a href="/admin/excel/export?type=donation" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.55rem 1rem;">
            <i class="fa-solid fa-file-arrow-down"></i> Export Donations
          </a>
          <a href="/admin/excel/export?type=tshirt" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.55rem 1rem;">
            <i class="fa-solid fa-file-arrow-down"></i> Export T-Shirts
          </a>
          <a href="/admin/excel/export-combined" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.55rem 1.1rem; box-shadow: 0 0 12px rgba(212, 175, 55, 0.35);">
            <i class="fa-solid fa-file-zipper"></i> Export Combined
          </a>
        </div>
      </div>

      <div class="table-scroll-hint">
        <i class="fa-solid fa-arrows-left-right"></i> आडवे स्क्रोल करा (Scroll horizontally to view all columns)
      </div>

      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Sheet</th>
              <th>Type</th>
              <th>File</th>
              <th>Columns</th>
              <th>Uploaded</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
          <% if (!sheets.length) { %>
            <tr>
              <td colspan="6" style="padding: 2rem; text-align: center; color: #9CA3AF;">No Excel sheets uploaded yet.</td>
            </tr>
          <% } %>
          <% sheets.forEach(sheet => { %>
            <tr>
              <td style="font-weight: 700; color: #FFFFFF;"><%= sheet.sheet_name %></td>
              <td>
                <% if (sheet.record_type === 'donation') { %>
                  <span style="color: var(--gold-soft); font-weight: 700;">Donation</span>
                <% } else { %>
                  <span style="color: var(--primary-saffron); font-weight: 700;">T-Shirt</span>
                <% } %>
              </td>
              <td><%= sheet.original_filename %></td>
              <td><%= (sheet.columns || []).length %></td>
              <td style="font-size: 0.82rem; color: #D1D5DB;"><%= sheet.uploaded_at ? new Date(sheet.uploaded_at).toLocaleString('en-IN') : '' %></td>
              <td style="white-space: nowrap;">
                <a href="/admin/excel?sheet=<%= sheet.id %>" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.8rem; border-color: rgba(212, 175, 55, 0.4);">
                  <i class="fa-solid fa-eye"></i> View
                </a>
                <form action="/admin/excel/delete/<%= sheet.id %>" method="POST" style="display: inline;" onsubmit="return confirm('Delete this uploaded Excel sheet and its records?');">
                  <button type="submit" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.8rem; border-color: rgba(239, 68, 68, 0.4); color: #FCA5A5;">
                    <i class="fa-solid fa-trash-can"></i> Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Selected Sheet Rows Viewer -->
    <% if (selectedSheet) { %>
      <div class="card-temple" style="padding: clamp(1.4rem, 4vw, 2.2rem);">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem;">
          <div>
            <h2 style="color: #F4EDE0; margin: 0; font-size: clamp(1.2rem, 3.8vw, 1.5rem); text-shadow: 0 0 12px rgba(212, 175, 55, 0.35);"><%= selectedSheet.sheet_name %></h2>
            <p style="color: #9CA3AF; margin: 0.3rem 0 0; font-size: 0.88rem;"><%= selectedSheet.record_type === 'donation' ? 'Offline Donations' : 'Offline T-Shirt Bookings' %> · <%= selectedRows.length %> records · <%= selectedSheet.columns.length %> columns</p>
          </div>
          <a href="/admin/excel/export?type=<%= selectedSheet.record_type %>" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.55rem 1rem;">
            <i class="fa-solid fa-download"></i> Export Type
          </a>
        </div>

        <div class="table-scroll-hint">
          <i class="fa-solid fa-arrows-left-right"></i> आडवे स्क्रोल करा (Scroll horizontally to view all columns)
        </div>

        <div class="admin-table-container" style="max-height: 650px;">
          <table class="admin-table" style="min-width: max-content;">
            <thead>
              <tr>
                <th style="position: sticky; top: 0; background: #3A170A; z-index: 2;">Row</th>
                <% selectedSheet.columns.forEach(column => { %>
                  <th style="position: sticky; top: 0; background: #3A170A; z-index: 2;"><%= column %></th>
                <% }) %>
              </tr>
            </thead>
            <tbody>
            <% selectedRows.forEach(row => { %>
              <tr>
                <td style="font-weight: 700; color: var(--gold-soft);"><%= row.row_number %></td>
                <% selectedSheet.columns.forEach(column => { %>
                  <td><%= row.data[column] ?? '' %></td>
                <% }) %>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
